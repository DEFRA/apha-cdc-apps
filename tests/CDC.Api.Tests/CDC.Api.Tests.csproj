<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CDC.Graph is measured by its own CDC.Graph.Tests project; only CDC.Api counts here. -->
    <Exclude>[CDC.Graph]*</Exclude>
    <!-- CDC.Graph's resilience package brings in the Microsoft.Gen.Logging source generator (as it already does in
         CDC.Web via CDC.Auth.Entra). Its generated Logging.g.cs has a "really log" branch that NullLogger never
         reaches, so it is excluded, as in CDC.Auth.Entra.Tests. Comma-separated: coverlet's glob parser misreads
         more than one semicolon-separated pattern. -->
    <ExcludeByFile>**/Logging.g.cs</ExcludeByFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <!-- FluentAssertions 7.x is the last Apache-2.0 release; 8+ requires a paid licence. -->
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="AutoFixture.AutoMoq" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CDC.Api\CDC.Api.csproj" />
  </ItemGroup>

</Project>