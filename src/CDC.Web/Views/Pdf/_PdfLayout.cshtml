<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10pt;
            color: #000;
            line-height: 1.4;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        h1.pdf-version-heading {
            margin: 0 0 10px 0;
            padding-bottom: 8px;
            border-bottom: 1px solid #000;
            font-size: 12pt;
        }

        .pdf-version + .pdf-version { break-before: page; }

        h2.pdf-section-heading {
            margin: 14px 0 6px 0;
            padding-bottom: 2px;
            border-bottom: 1px solid #000;
            font-size: 11pt;
            break-after: avoid;
        }

        table.pdf-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 6px;
        }

        .pdf-table th,
        .pdf-table td {
            border: 1px solid #000;
            padding: 3px 6px;
            text-align: left;
            vertical-align: top;
            overflow-wrap: anywhere;
        }

        .pdf-table th {
            background-color: #00a33b;
            color: #fff;
        }

        .pdf-table tr { break-inside: avoid; }

        .pdf-empty {
            padding: 4px 0;
            text-align: center;
            font-style: italic;
        }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
