@model CDC.Web.Models.ContributionsReportViewModel
@{
    Layout = "/Views/Pdf/_PdfLayout.cshtml";
    ViewData["Title"] = "Contributions report";
}
@foreach (var version in Model.Versions)
{
    <section class="pdf-version">
        <h1 class="pdf-version-heading">@version.Heading</h1>

        @foreach (var profileSection in version.Sections)
        {
            <h2 class="pdf-section-heading">@profileSection.Heading</h2>

            @if (profileSection.Rows.Count == 0)
            {
                <p class="pdf-empty">- No contributions -</p>
            }
            else
            {
                <table class="pdf-table">
                    <thead>
                        <tr>
                            <th scope="col">Full name</th>
                            <th scope="col">Organisation</th>
                            <th scope="col">Contribution date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in profileSection.Rows)
                        {
                            <tr>
                                <td>@row.FullName</td>
                                <td>@row.Organisation</td>
                                <td>@row.ContributionDate</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </section>
}
