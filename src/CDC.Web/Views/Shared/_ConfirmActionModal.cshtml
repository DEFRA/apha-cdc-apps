@model CDC.Web.Models.ConfirmActionModalViewModel
<dialog class="app-modal" id="@Model.ModalId" aria-labelledby="@(Model.ModalId)-title">
    <h2 class="govuk-heading-m" id="@(Model.ModalId)-title">Confirm</h2>
    <p class="govuk-body">@Model.BodyText</p>
    <form method="post" asp-page-handler="@Model.PageHandler">
        <input type="hidden" name="ProfileId" value="@Model.ProfileId" />
        <button type="submit" class="govuk-button govuk-!-margin-bottom-0 govuk-!-margin-right-2">Ok</button>
        <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-confirm-close>Cancel</button>
    </form>
</dialog>

