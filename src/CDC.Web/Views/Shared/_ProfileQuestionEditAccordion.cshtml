@model CDC.Web.Models.QuestionEditAccordionViewModel
@if (Model.Questions.Count == 0)
{
    <p class="govuk-body">@Model.EmptyMessage</p>
}
else
{
    @* The legacy panels opened collapsed whenever the page was opened and kept their state only across the page's own postbacks. *@
    <div class="govuk-accordion" data-module="govuk-accordion" id="@(Model.IdPrefix)" data-app-collapse-on-open="@(Model.CollapseOnOpen ? "true" : "false")">
        @foreach (var (index, question) in Model.Questions.Index())
        {
            <div class="govuk-accordion__section" hidden="@(question.IsHidden ? "hidden" : null)">
                @* The accordion toggles a question from its header, so the icons sit beside it, at the right as in the legacy panel header. *@
                <div class="app-question-section-header">
                    <div class="govuk-accordion__section-header">
                        <h2 class="govuk-accordion__section-heading">
                            <span class="govuk-accordion__section-button" id="@QuestionEditAccordionViewModel.HeadingId(Model.IdPrefix, question.Number)">
                                @question.Number @question.Text
                            </span>
                        </h2>
                    </div>
                    <div class="app-question-status-icons">
                        @if (question.CanEditReferences)
                        {
                            <button type="button" class="app-question-icon-button" data-question-references="@question.Id" data-question-number="@question.Number" aria-haspopup="dialog" title="Edit references">
                                <img src="~/assets/images/references.png" alt="Edit references for @question.Number" class="app-question-status-icon" />
                            </button>
                        }
                        @if (question.IsValid == true)
                        {
                            <img src="~/assets/images/green-check.png" alt="This question has no validation errors" title="Validation success" class="app-question-status-icon" />
                        }
                        else if (question.IsValid == false)
                        {
                            <img src="~/assets/images/red-cross.png" alt="This question has validation errors" title="Validation failed" class="app-question-status-icon" />
                        }
                        <button type="button" class="app-question-icon-button" data-question-help="@question.Id" aria-haspopup="dialog" title="Help">
                            <img src="~/assets/images/help-button.png" alt="Help for @question.Number" class="app-question-status-icon" />
                        </button>
                    </div>
                </div>
                @* The accordion script points each button's aria-controls at {accordion id}-content-{position}, and remembers what is open under that name. *@
                <div id="@(Model.IdPrefix)-content-@(index + 1)" class="govuk-accordion__section-content">
                    @if (question.SpeciesRows is not null)
                    {
                        <partial name="_ProfileSpeciesQuestion" model="question" />
                    }
                    else if (question.Rows is not null)
                    {
                        <partial name="_ProfileRepeatingQuestion" model="question" />
                    }
                    else
                    {
                        @foreach (var field in question.Fields)
                        {
                            @if (field.VisibleWhen is { } rule)
                            {
                                @* Shown only while the answer it depends on is the one it names, as the legacy page did; its inputs stay on the page, so the form still posts them. *@
                                <div data-visible-when-field="@rule.ControlId" data-visible-when-value="@rule.ValueId" hidden="@(rule.IsShown ? null : "hidden")">
                                    <partial name="_ProfileFieldEdit" model="field" />
                                </div>
                            }
                            else
                            {
                                <partial name="_ProfileFieldEdit" model="field" />
                            }
                        }
                    }
                </div>
            </div>
        }
    </div>
}
