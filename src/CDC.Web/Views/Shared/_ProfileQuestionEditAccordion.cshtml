@model CDC.Web.Models.QuestionEditAccordionViewModel
@if (Model.Questions.Count == 0)
{
    <p class="govuk-body">@Model.EmptyMessage</p>
}
else
{
    <div class="govuk-accordion" data-module="govuk-accordion" id="@(Model.IdPrefix)">
        @foreach (var question in Model.Questions)
        {
            var anchor = question.Number.Replace(".", "-");
            <div class="govuk-accordion__section" hidden="@(question.IsHidden ? "hidden" : null)">
                <div class="govuk-accordion__section-header app-question-section-header">
                    <h2 class="govuk-accordion__section-heading">
                        <span class="govuk-accordion__section-button" id="@QuestionEditAccordionViewModel.HeadingId(Model.IdPrefix, question.Number)">
                            @question.Number @question.Text
                        </span>
                    </h2>
                    <div class="app-question-status-icons">
                        @if (question.CanEditReferences)
                        {
                            <img src="~/assets/images/references.png" alt="Edit references for @question.Number" title="Edit references" class="app-question-status-icon" />
                        }
                        @if (question.IsValid == true)
                        {
                            <img src="~/assets/images/green-check.png" alt="This question has no validation errors" title="Validation success" class="app-question-status-icon" />
                        }
                        else if (question.IsValid == false)
                        {
                            <img src="~/assets/images/red-cross.png" alt="This question has validation errors" title="Validation failed" class="app-question-status-icon" />
                        }
                        <img src="~/assets/images/help-button.png" alt="Help for @question.Number" title="Help" class="app-question-status-icon" />
                    </div>
                </div>
                <div id="@(Model.IdPrefix)-content-@anchor" class="govuk-accordion__section-content">
                    @foreach (var field in question.Fields)
                    {
                        <partial name="_ProfileFieldEdit" model="field" />
                    }
                </div>
            </div>
        }
    </div>
}
