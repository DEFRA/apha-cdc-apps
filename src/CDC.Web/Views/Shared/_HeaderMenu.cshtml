@using CDC.Web.Models
@using CDC.Web.Authorization.Services
@inject INavigationAuthorizationService NavigationAuthorizationService
@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
}

<div class="govuk-width-container">
    <div class="govuk-grid-row app-menu-panel__row">
        @foreach (var menuSection in HeaderMenu.Sections)
        {
            var visibleLinks = new List<HeaderMenuLink>();
            foreach (var link in menuSection.Links)
            {
                if (await NavigationAuthorizationService.CanAccessAsync(User, link.RequiredPolicy))
                {
                    visibleLinks.Add(link);
                }
            }

            if (visibleLinks.Count > 0)
            {
                <div class="govuk-grid-column-one-third">
                    <h2 class="govuk-heading-s app-menu-panel__heading">@menuSection.Title</h2>
                    <ul class="govuk-list app-menu-panel__list">
                        @foreach (var link in visibleLinks)
                        {
                            // profileId is set to null explicitly so a link to the Profile properties page (whose route has an
                            // optional profileId) does not reuse the profile id of the page the user is on, which would turn
                            // "Create profile" into "Edit this profile".
                            var href = Url.Page(link.PagePath, new { profileId = (Guid?)null });
                            var isActive = string.Equals(href, currentPath, StringComparison.OrdinalIgnoreCase);
                            <li>
                                <a class="govuk-link govuk-link--no-visited-state app-menu-panel__link@(isActive ? " app-menu-panel__link--active" : string.Empty)"
                                   href="@href"
                                   aria-current="@(isActive ? "page" : null)">@link.Text</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>
</div>
