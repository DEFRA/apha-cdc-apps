@model CDC.Web.Models.TreeViewNodeViewModel
@{
    var node = Model.Node;
    var checkboxId = $"{Model.IdPrefix}-{node.Value}";
}

<li class="app-tree__item" data-app-tree-expanded="@(node.Expanded ? "true" : "false")">
    <div class="app-tree__row">
        <div class="govuk-checkboxes__item app-tree__checkbox">
            <input class="govuk-checkboxes__input" id="@checkboxId" name="@Model.FieldName" type="checkbox" value="@node.Value" />
            <label class="govuk-label govuk-checkboxes__label" for="@checkboxId">@node.Label</label>
        </div>
    </div>
    @if (node.Children.Count > 0)
    {
        <ul class="app-tree__group">
            @foreach (var child in node.Children)
            {
                <partial name="_TreeViewNode" model="new TreeViewNodeViewModel(child, Model.IdPrefix, Model.FieldName)" />
            }
        </ul>
    }
</li>
