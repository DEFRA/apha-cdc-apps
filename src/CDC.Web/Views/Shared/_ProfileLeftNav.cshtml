@model CDC.Web.Models.ProfileLeftNavViewModel
@{
    var showSummaryProfileReport = Model.CanViewProfileReports && Model.SummaryProfileReportUrl is not null;
    var showSummaryPrioritisationReport = Model.CanViewProfileReports && Model.SummaryPrioritisationReportUrl is not null;
}
<h2 class="govuk-heading-s">Profile reports</h2>
@if (Model.CanPrintProfileSection || showSummaryProfileReport || showSummaryPrioritisationReport)
{
    @* The links download PDFs in a new tab, so an error page cannot lose edits made on this page. *@
    <ul class="govuk-list govuk-body govuk-!-font-size-16">
        @if (Model.CanPrintProfileSection)
        {
            <li>
                <a class="govuk-link govuk-link--no-visited-state" href="@Model.PrintFullProfileUrl" target="_blank" rel="noopener noreferrer">Print full profile<span class="govuk-visually-hidden"> (opens in new tab)</span></a>
            </li>
        }
        @if (showSummaryProfileReport)
        {
            <li>
                <a class="govuk-link govuk-link--no-visited-state" href="@Model.SummaryProfileReportUrl" target="_blank" rel="noopener noreferrer">Summary profile report<span class="govuk-visually-hidden"> (opens in new tab)</span></a>
            </li>
        }
        @if (showSummaryPrioritisationReport)
        {
            <li>
                <a class="govuk-link govuk-link--no-visited-state" href="@Model.SummaryPrioritisationReportUrl" target="_blank" rel="noopener noreferrer">Summary prioritisation report<span class="govuk-visually-hidden"> (opens in new tab)</span></a>
            </li>
        }
    </ul>
}
else
{
    <p class="govuk-body govuk-!-font-size-16">No profile reports are available for this version.</p>
}

<h2 class="govuk-heading-s">
    @if (Model.NotesUrl is not null)
    {
        <a class="govuk-link govuk-link--no-visited-state govuk-link--no-underline app-subnav__item @(Model.IsNotesActive ? "app-subnav__item--current" : string.Empty)"
           href="@Model.NotesUrl" aria-current="@(Model.IsNotesActive ? "page" : null)">Profile references</a>
    }
    else
    {
        <span>Profile references</span>
    }
</h2>
<partial name="_SectionSubnav" model="Model.Subnav" />
