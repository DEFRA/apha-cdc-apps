@model CDC.Web.Models.ProfileFieldEditView
@using CDC.Web.Infrastructure
@{
    var inputName = $"field_{Model.FieldId}";

    // Many fields have no label of their own, for the question's text is what they answer, so a control still needs a name for a screen reader.
    var hasLabel = !string.IsNullOrWhiteSpace(Model.Label);
    var labelText = hasLabel ? Model.Label : Model.LabelFallback;
    var labelClass = hasLabel ? "govuk-label govuk-label--s" : "govuk-label govuk-visually-hidden";
    var legendClass = hasLabel ? "govuk-fieldset__legend govuk-fieldset__legend--s" : "govuk-fieldset__legend govuk-visually-hidden";

    // As the legacy page did, a list of choices says to select all that apply, and says it on its own when the field has no name.
    var multiLegend = hasLabel ? $"{Model.Label} (please select all that apply)" : "Please select all that apply";
}
@if (!Model.IsEditable)
{
    @if (Model.Options.Count > 0)
    {
        <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
                <legend class="@legendClass">@labelText</legend>
                <div class="govuk-checkboxes govuk-checkboxes--small app-checkboxes--columns" data-module="govuk-checkboxes">
                    @for (var optionIndex = 0; optionIndex < Model.Options.Count; optionIndex++)
                    {
                        var option = Model.Options[optionIndex];
                        var optionId = $"{inputName}-readonly-{optionIndex}";
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" id="@optionId" type="checkbox" disabled checked="@(option.IsChecked ? "checked" : null)" />
                            <label class="govuk-label govuk-checkboxes__label" for="@optionId">@option.Text</label>
                        </div>
                    }
                </div>
            </fieldset>
        </div>
    }
    else if (string.Equals(Model.DataTypeName, "Boolean", StringComparison.OrdinalIgnoreCase))
    {
        @* As the legacy page showed a Boolean the user may not change: a Yes and a No box, one ticked, neither of which can be changed. *@
        <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
                <legend class="@legendClass">@labelText</legend>
                <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input" id="@(inputName)-readonly-yes" type="checkbox" disabled checked="@(Model.BooleanValue == true ? "checked" : null)" />
                        <label class="govuk-label govuk-checkboxes__label" for="@(inputName)-readonly-yes">Yes</label>
                    </div>
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input" id="@(inputName)-readonly-no" type="checkbox" disabled checked="@(Model.BooleanValue == false ? "checked" : null)" />
                        <label class="govuk-label govuk-checkboxes__label" for="@(inputName)-readonly-no">No</label>
                    </div>
                </div>
            </fieldset>
        </div>
    }
    else if (string.Equals(Model.DataTypeName, "Profile Version Data", StringComparison.OrdinalIgnoreCase))
    {
        @* As the legacy page showed such a field, which is a property of the version (the species it profiles) and so read-only: its text in a
           bordered white box, which keeps its height when the text is empty. *@
        <div class="govuk-form-group">
            @if (hasLabel)
            {
                <h3 class="govuk-heading-s govuk-!-margin-bottom-1">@Model.Label</h3>
            }
            <p class="govuk-body app-version-data-box">
                @if (!hasLabel)
                {
                    <span class="govuk-visually-hidden">@(Model.LabelFallback): </span>
                }
                @ProfileTitleHtmlFormatter.Format(Model.ValueDisplay)
            </p>
        </div>
    }
    else if (Model.IsHtml)
    {
        @* As the legacy page showed a long answer the user may not change: in a bordered box of a fixed height that always scrolls. *@
        <div class="govuk-form-group">
            @if (hasLabel)
            {
                <h3 class="govuk-heading-s govuk-!-margin-bottom-1" id="@(inputName)-label">@Model.Label</h3>
            }
            <section class="govuk-body-s app-readonly-long-text" aria-labelledby="@(hasLabel ? $"{inputName}-label" : null)" aria-label="@(hasLabel ? null : Model.LabelFallback)">@Html.Raw(Model.ValueDisplay)</section>
        </div>
    }
    else
    {
        @* As the legacy page showed any other answer the user may not change: its text in a bordered white box. *@
        <div class="govuk-form-group">
            @if (hasLabel)
            {
                <h3 class="govuk-heading-s govuk-!-margin-bottom-1">@Model.Label</h3>
            }
            <p class="govuk-body app-version-data-box">
                @if (!hasLabel)
                {
                    <span class="govuk-visually-hidden">@(Model.LabelFallback): </span>
                }
                @Model.ValueDisplay
            </p>
        </div>
    }
}
else
{
    @switch (Model.DataTypeName)
    {
        case "Boolean":
            <div class="govuk-form-group">
                <label class="@labelClass" for="@inputName">@labelText</label>
                <select class="govuk-select" id="@inputName" name="@inputName" @Model.RelevanceAttribute>
                    <option value="">Please select...</option>
                    <option value="true" selected="@(Model.BooleanValue == true ? "selected" : null)">Yes</option>
                    <option value="false" selected="@(Model.BooleanValue == false ? "selected" : null)">No</option>
                </select>
            </div>
            break;
        case "List":
            <div class="govuk-form-group">
                <label class="@labelClass" for="@inputName">@labelText</label>
                <select class="govuk-select" id="@inputName" name="@inputName" @Model.RelevanceAttribute>
                    <option value="">Please select...</option>
                    @foreach (var option in Model.Options)
                    {
                        <option value="@option.Id" selected="@(option.IsChecked ? "selected" : null)">@option.Text</option>
                    }
                </select>
            </div>
            break;
        case "MultiValueList":
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
                        @if (!hasLabel)
                        {
                            <span class="govuk-visually-hidden">@(Model.LabelFallback):</span>
                        }
                        @multiLegend
                    </legend>
                    <div class="govuk-checkboxes govuk-checkboxes--small app-checkboxes--columns" data-module="govuk-checkboxes">
                        @for (var optionIndex = 0; optionIndex < Model.Options.Count; optionIndex++)
                        {
                            var option = Model.Options[optionIndex];
                            var optionId = $"{inputName}-{optionIndex}";
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" id="@optionId" name="@inputName" type="checkbox" value="@option.Id" checked="@(option.IsChecked ? "checked" : null)" />
                                <label class="govuk-label govuk-checkboxes__label" for="@optionId">@option.Text</label>
                            </div>
                        }
                    </div>
                </fieldset>
            </div>
            break;
        case "Decimal":
            <div class="govuk-form-group">
                <label class="govuk-label" for="@inputName">@Model.Label</label>
                <input class="govuk-input govuk-input--width-10" id="@inputName" name="@inputName" type="text" inputmode="decimal" value="@Model.DecimalValue?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            break;
        case "Date":
            <div class="govuk-form-group">
                <fieldset class="govuk-fieldset" role="group">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">@Model.Label</legend>
                    <div class="govuk-date-input" id="@inputName" data-module="app-date-picker" data-date-picker-label="Choose date for @Model.Label">
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" for="@(inputName)_day">Day</label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-2" id="@(inputName)_day" name="@(inputName)_day" type="text" inputmode="numeric" value="@Model.DateValue?.Day" data-date-picker-part="day" />
                            </div>
                        </div>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" for="@(inputName)_month">Month</label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-2" id="@(inputName)_month" name="@(inputName)_month" type="text" inputmode="numeric" value="@Model.DateValue?.Month" data-date-picker-part="month" />
                            </div>
                        </div>
                        <div class="govuk-date-input__item">
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-date-input__label" for="@(inputName)_year">Year</label>
                                <input class="govuk-input govuk-date-input__input govuk-input--width-4" id="@(inputName)_year" name="@(inputName)_year" type="text" inputmode="numeric" value="@Model.DateValue?.Year" data-date-picker-part="year" />
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            break;
        case "Long Text":
            <div class="govuk-form-group">
                <label class="govuk-label" for="@inputName">@Model.Label</label>
                <div class="app-richtext-toolbar" role="toolbar" aria-label="@Model.Label formatting">
                    <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon" data-richtext-command="undo" data-richtext-target="@inputName" aria-label="Undo" title="Undo">&#8630;</button>
                    <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon" data-richtext-command="redo" data-richtext-target="@inputName" aria-label="Redo" title="Redo">&#8631;</button>
                    <span class="app-richtext-toolbar__divider" aria-hidden="true"></span>
                    <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon app-richtext-toolbar__button--italic" data-richtext-command="italic" data-richtext-target="@inputName" aria-label="Italic" title="Italic">I</button>
                    <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon" data-richtext-command="bullist" data-richtext-target="@inputName" aria-label="Bulleted list" title="Bulleted list"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="2" cy="3" r="1.5"/><circle cx="2" cy="8" r="1.5"/><circle cx="2" cy="13" r="1.5"/><rect x="6" y="2" width="10" height="2"/><rect x="6" y="7" width="10" height="2"/><rect x="6" y="12" width="10" height="2"/></svg></button>
                    <span class="app-richtext-toolbar__divider" aria-hidden="true"></span>
                    <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon" data-richtext-command="link" data-richtext-target="@inputName" aria-label="Insert link" title="Insert link">&#128279;</button>
                </div>
                <textarea class="govuk-textarea app-richtext-editor" id="@inputName" name="@inputName" rows="8" spellcheck="true">@Model.TextValue</textarea>
                <button type="button" class="govuk-button govuk-!-margin-top-2" data-spellcheck-target="@inputName">Spell check</button>
            </div>
            break;
        default:
            <div class="govuk-form-group">
                <label class="govuk-label" for="@inputName">@Model.Label</label>
                <input class="govuk-input" id="@inputName" name="@inputName" type="text" maxlength="255" value="@Model.TextValue" spellcheck="true" />
                <button type="button" class="govuk-button govuk-!-margin-top-2" data-spellcheck-target="@inputName">Spell check</button>
            </div>
            break;
    }
}
