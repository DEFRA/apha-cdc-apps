@model CDC.Web.Pages.EditSpeciesModel
@if (Model.EditableQuestions.Count == 0)
{
    <div class="app-species-tabs">
        <span class="app-species-tabs__tab app-species-tabs__tab--active">@Model.CurrentSection.Title</span>
    </div>
    <p class="govuk-body app-species-panel">No sub-sections are available for this section.</p>
}
else
{
    <form method="post" asp-page-handler="Save" asp-route-speciesId="@Model.SpeciesId" asp-route-section="@Model.CurrentSection.Key" asp-route-edit="true">
        <input type="hidden" name="LastUpdatedBase64" value="@Convert.ToBase64String(Model.AnswerDataLastUpdated)" />

        <div class="govuk-button-group app-button-group--right">
            <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
        </div>

        <div class="app-species-tabs">
            <span class="app-species-tabs__tab app-species-tabs__tab--active">@Model.CurrentSection.Title</span>
        </div>

        <div class="app-species-panel">
        @* Remembered state would reopen the sub-sections of the previous section; the legacy page always opened collapsed. *@
        <div class="govuk-accordion" data-module="govuk-accordion" data-remember-expanded="false" id="edit-species-accordion">
            @foreach (var question in Model.EditableQuestions)
            {
                var anchor = question.Number.Replace(".", "-");
                <div class="govuk-accordion__section" id="question-@anchor">
                    <div class="govuk-accordion__section-header">
                        <h3 class="govuk-accordion__section-heading">
                            <span class="govuk-accordion__section-button" id="edit-species-accordion-heading-@anchor">
                                @question.Number @question.Text
                            </span>
                        </h3>
                    </div>
                    <div id="edit-species-accordion-content-@anchor" class="govuk-accordion__section-content">
                        @foreach (var field in question.Fields)
                        {
                            var fieldName = $"field_{field.FieldId}";

                            if (string.Equals(field.DataTypeName, "MultiValueList", StringComparison.OrdinalIgnoreCase))
                            {
                                <fieldset class="govuk-fieldset">
                                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">@field.Label</legend>
                                    <div class="govuk-checkboxes govuk-checkboxes--small app-checkboxes--columns" data-module="govuk-checkboxes">
                                        @for (var optionIndex = 0; optionIndex < field.Options.Count; optionIndex++)
                                        {
                                            var option = field.Options[optionIndex];
                                            var optionId = $"{fieldName}-{optionIndex}";
                                            <div class="govuk-checkboxes__item">
                                                <input class="govuk-checkboxes__input" id="@optionId" name="@fieldName" type="checkbox" value="@option.Id" checked="@(option.IsChecked ? "checked" : null)" />
                                                <label class="govuk-label govuk-checkboxes__label" for="@optionId">@option.Text</label>
                                            </div>
                                        }
                                    </div>
                                </fieldset>
                            }
                            else if (string.Equals(field.DataTypeName, "List", StringComparison.OrdinalIgnoreCase))
                            {
                                // Legacy DropDownListProfileField: a single-select dropdown, not radios.
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="@fieldName">@field.Label</label>
                                    <select class="govuk-select" id="@fieldName" name="@fieldName">
                                        <option value="">Please select...</option>
                                        @foreach (var option in field.Options)
                                        {
                                            <option value="@option.Id" selected="@(option.IsChecked ? "selected" : null)">@option.Text</option>
                                        }
                                    </select>
                                </div>
                            }
                            else if (string.Equals(field.DataTypeName, "Boolean", StringComparison.OrdinalIgnoreCase))
                            {
                                // Legacy BooleanProfileField: a Yes/No dropdown, not a checkbox or radios.
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="@fieldName">@field.Label</label>
                                    <select class="govuk-select" id="@fieldName" name="@fieldName">
                                        <option value="">Please select...</option>
                                        <option value="true" selected="@(field.BooleanValue == true ? "selected" : null)">Yes</option>
                                        <option value="false" selected="@(field.BooleanValue == false ? "selected" : null)">No</option>
                                    </select>
                                </div>
                            }
                            else if (string.Equals(field.DataTypeName, "Long Text", StringComparison.OrdinalIgnoreCase))
                            {
                                // Legacy LongTextProfileField: TinyMCE toolbar (undo, redo, italic, bullets, link) plus RadSpell.
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="@fieldName">@field.Label</label>
                                    <div class="app-richtext-toolbar" role="toolbar" aria-label="@field.Label formatting">
                                        <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon" data-richtext-command="undo" data-richtext-target="@fieldName" aria-label="Undo" title="Undo">&#8630;</button>
                                        <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon" data-richtext-command="redo" data-richtext-target="@fieldName" aria-label="Redo" title="Redo">&#8631;</button>
                                        <span class="app-richtext-toolbar__divider" aria-hidden="true"></span>
                                        <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon app-richtext-toolbar__button--italic" data-richtext-command="italic" data-richtext-target="@fieldName" aria-label="Italic" title="Italic">I</button>
                                        <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon" data-richtext-command="bullist" data-richtext-target="@fieldName" aria-label="Bulleted list" title="Bulleted list"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="2" cy="3" r="1.5"/><circle cx="2" cy="8" r="1.5"/><circle cx="2" cy="13" r="1.5"/><rect x="6" y="2" width="10" height="2"/><rect x="6" y="7" width="10" height="2"/><rect x="6" y="12" width="10" height="2"/></svg></button>
                                        <span class="app-richtext-toolbar__divider" aria-hidden="true"></span>
                                        <button type="button" class="app-richtext-toolbar__button app-richtext-toolbar__button--icon" data-richtext-command="link" data-richtext-target="@fieldName" aria-label="Insert link" title="Insert link">&#128279;</button>
                                    </div>
                                    <textarea class="govuk-textarea app-richtext-editor" id="@fieldName" name="@fieldName" rows="8" spellcheck="true">@field.TextValue</textarea>
                                    <button type="button" class="govuk-button govuk-!-margin-top-2" data-spellcheck-target="@fieldName">Spell check</button>
                                </div>
                            }
                            else
                            {
                                <div class="govuk-form-group">
                                    <label class="govuk-label" for="@fieldName">@field.Label</label>
                                    <textarea class="govuk-textarea" id="@fieldName" name="@fieldName" rows="3">@field.TextValue</textarea>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
        </div>

        <div class="govuk-button-group app-button-group--right govuk-!-margin-top-6">
            <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
        </div>
    </form>
}
