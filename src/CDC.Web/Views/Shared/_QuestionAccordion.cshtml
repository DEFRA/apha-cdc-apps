@model CDC.Web.Models.QuestionAccordionViewModel
@if (Model.Questions.Count == 0)
{
    <p class="govuk-body">@Model.EmptyMessage</p>
}
else
{
    @* Remembered state would reopen the sub-sections of the previous section; the legacy page always opened collapsed. *@
    <div class="govuk-accordion" data-module="govuk-accordion" data-remember-expanded="false" id="@(Model.IdPrefix)">
        @foreach (var question in Model.Questions)
        {
            var anchor = question.Number.Replace(".", "-");
            <div class="govuk-accordion__section">
                <div class="govuk-accordion__section-header">
                    <h2 class="govuk-accordion__section-heading">
                        <span class="govuk-accordion__section-button" id="@(Model.IdPrefix)-heading-@anchor">
                            @question.Number @question.Text
                        </span>
                    </h2>
                </div>
                <div id="@(Model.IdPrefix)-content-@anchor" class="govuk-accordion__section-content">
                    @for (var fieldIndex = 0; fieldIndex < question.Fields.Count; fieldIndex++)
                    {
                        var field = question.Fields[fieldIndex];

                        if (field.Options.Count > 0)
                        {
                            <div class="govuk-form-group">
                                <fieldset class="govuk-fieldset">
                                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">@field.Label</legend>
                                    <div class="govuk-checkboxes govuk-checkboxes--small app-checkboxes--columns" data-module="govuk-checkboxes">
                                        @for (var optionIndex = 0; optionIndex < field.Options.Count; optionIndex++)
                                        {
                                            var option = field.Options[optionIndex];
                                            var optionId = $"{anchor}-option-{optionIndex}";
                                            <div class="govuk-checkboxes__item">
                                                <input class="govuk-checkboxes__input" id="@optionId" type="checkbox" disabled checked="@(option.IsChecked ? "checked" : null)" />
                                                <label class="govuk-label govuk-checkboxes__label" for="@optionId">@option.Text</label>
                                            </div>
                                        }
                                    </div>
                                </fieldset>
                            </div>
                        }
                        else if (field.IsHtml)
                        {
                            var labelId = $"{Model.IdPrefix}-field-{anchor}-{fieldIndex}-label";
                            <div class="govuk-form-group">
                                @if (!string.IsNullOrEmpty(field.Label))
                                {
                                    <h3 class="govuk-heading-s govuk-!-margin-bottom-1" id="@labelId">@field.Label</h3>
                                }
                                @* The legacy page showed a long answer in a fixed-height box that always scrolls; the text is sanitised by the page model.
                                   There is deliberately no tabindex: browsers make a scroller with nothing focusable inside it keyboard focusable themselves,
                                   and Sonar rule S6845 (a Major issue, which fails the quality gate) rejects tabindex on a non-interactive element. *@
                                <section class="govuk-body-s app-readonly-long-text" aria-labelledby="@(string.IsNullOrEmpty(field.Label) ? null : labelId)">@Html.Raw(field.ValueDisplay)</section>
                            </div>
                        }
                        else if (string.IsNullOrEmpty(field.Label))
                        {
                            <p class="govuk-body">@field.ValueDisplay</p>
                        }
                        else
                        {
                            <dl class="govuk-summary-list">
                                <div class="govuk-summary-list__row">
                                    <dt class="govuk-summary-list__key">@field.Label</dt>
                                    <dd class="govuk-summary-list__value">@field.ValueDisplay</dd>
                                </div>
                            </dl>
                        }
                    }
                </div>
            </div>
        }
    </div>
}
