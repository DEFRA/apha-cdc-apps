@model CDC.Web.Models.BreadcrumbViewModel

<div class="govuk-breadcrumbs">
    <ol class="govuk-breadcrumbs__list">
        <li class="govuk-breadcrumbs__list-item">
            <a class="govuk-breadcrumbs__link" asp-area="" asp-controller="Landing" asp-action="Internal">D2R2 Home</a>
        </li>
        @if (Model.ParentPageName is not null)
        {
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" href="@Model.ParentUrl">@Model.ParentPageName</a>
            </li>
        }
        <li class="govuk-breadcrumbs__list-item" aria-current="page">@Model.PageName</li>
    </ol>
</div>
