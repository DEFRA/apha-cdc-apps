@model CDC.Web.Models.SectionSubnavViewModel
<nav class="app-subnav" aria-label="@Model.AriaLabel">
    <ul class="app-subnav__list">
        @foreach (var item in Model.Items)
        {
            <li class="app-subnav__item @(item.IsCurrent ? "app-subnav__item--current" : string.Empty)">
                <a class="govuk-link govuk-link--no-visited-state govuk-link--no-underline"
                   href="@item.Url"
                   aria-current="@(item.IsCurrent ? "page" : null)">
                    @if (item.IsValid == true)
                    {
                        @* Matches the legacy ValidGreen.gif/Valid.gif icon: a filled green circle with a white tick. *@
                        <svg class="app-section-status app-section-status--valid" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
                            <title>Section validated</title>
                            <circle cx="10" cy="10" r="10" fill="currentColor" />
                            <path fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M6 10.2 8.7 12.9 14.5 7" />
                        </svg>
                        <span class="govuk-visually-hidden">Section validated: </span>
                    }
                    else if (item.IsValid == false)
                    {
                        @* Matches the legacy Invalid.gif/InvalidGreen.gif icon: a filled red circle with a white cross. *@
                        <svg class="app-section-status app-section-status--invalid" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
                            <title>Section not validated</title>
                            <circle cx="10" cy="10" r="10" fill="currentColor" />
                            <path fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" d="M7 7 13 13M13 7 7 13" />
                        </svg>
                        <span class="govuk-visually-hidden">Section not validated: </span>
                    }
                    @item.Number. @item.Title
                </a>
            </li>
        }
    </ul>
</nav>
