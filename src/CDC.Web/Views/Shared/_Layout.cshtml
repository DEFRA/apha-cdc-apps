<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1d70b8" />
    @{
        var pageTitle = ViewData["Title"] as string;
        var documentTitle = string.IsNullOrWhiteSpace(pageTitle) || pageTitle == "D2R2" ? "D2R2" : $"{pageTitle} - D2R2";
    }
    <title>@documentTitle</title>

    <link rel="icon" sizes="48x48" href="~/assets/images/favicon.ico" />
    <link rel="icon" sizes="any" href="~/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="~/assets/images/govuk-icon-mask.svg" color="#1d70b8" />
    <link rel="apple-touch-icon" href="~/assets/images/govuk-icon-180.png" />
    <link rel="manifest" href="~/assets/manifest.json" />

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/govuk-frontend-6.5.0.min.css" asp-append-version="true" />
    <!-- Bootstrap is retained only for the not-yet-migrated External user journey; remove once that path adopts GOV.UK Frontend. -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CDC.Web.styles.css" asp-append-version="true" />
</head>
<body class="govuk-template__body" id="top">
    <script>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>
    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>

    <header class="govuk-header" data-module="govuk-header">
        <div class="govuk-header__container govuk-width-container">
            <div class="govuk-header__logo">
                <a asp-area="" asp-controller="Landing" asp-action="Internal" class="govuk-header__homepage-link">
                    <span class="govuk-header__product-name">D2R2</span>
                </a>
            </div>
            @if (!(ViewData["HideAccountBar"] as bool? ?? false))
            {
                <div class="app-header__actions">
                    <nav aria-label="Menu" class="app-header__menu">
                        <button type="button" id="app-menu-toggle" class="govuk-service-navigation__toggle" aria-controls="app-menu-panel" aria-expanded="false" aria-label="Show or hide menu" data-app-menu-toggle>Menu</button>
                    </nav>
                    <span class="app-header__divider" aria-hidden="true"></span>
                    <a class="app-header__help-link" asp-page="/HelpSupport/HelpUsingD2R2" aria-label="Help using D2R2">
                        <img class="app-header__help-icon" src="~/assets/images/icon-questionMark.svg" alt="" />
                    </a>
                </div>
            }
        </div>
        @if (!(ViewData["HideAccountBar"] as bool? ?? false))
        {
            <div id="app-menu-panel" class="app-header__menu-panel" hidden>
                <partial name="_HeaderMenu" />
            </div>
        }
    </header>

    <div class="govuk-width-container">
        <div class="app-banner-row">
            <img class="app-banner-row__logo" src="~/assets/images/apha-logo-dark.png" alt="Animal and Plant Health Agency" />
            @if (!(ViewData["HideAccountBar"] as bool? ?? false))
            {
                <!-- Placeholder until Entra ID sign-in is implemented; username will come from the authenticated user's claims. -->
                <p class="govuk-body-s app-banner-row__account">
                    Signed in as <strong>Srinivas Bharadwaj Dodla</strong> &middot; <a class="govuk-link" asp-action="Index">Sign out</a>
                </p>
            }
        </div>

        @await RenderSectionAsync("Breadcrumbs", required: false)
        <main class="govuk-main-wrapper" id="main-content" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="govuk-footer">
        <div class="govuk-width-container">
            <div class="govuk-footer__navigation">
                <div class="govuk-footer__section govuk-grid-column-one-third">
                    <h2 class="govuk-footer__heading govuk-heading-m">User admin</h2>
                    <ul class="govuk-footer__list">
                        <li class="govuk-footer__list-item"><a class="govuk-footer__link" asp-page="/UserAdmin/GlobalUsers">Global users</a></li>
                        <li class="govuk-footer__list-item"><a class="govuk-footer__link" asp-page="/UserAdmin/ExternalUsers">External users</a></li>
                    </ul>
                </div>
                <div class="govuk-footer__section govuk-grid-column-one-third">
                    <h2 class="govuk-footer__heading govuk-heading-m">Cross profile admin</h2>
                    <ul class="govuk-footer__list">
                        <li class="govuk-footer__list-item"><a class="govuk-footer__link" asp-page="/CrossProfileAdmin/ReferenceData">Maintain reference data</a></li>
                        <li class="govuk-footer__list-item"><a class="govuk-footer__link" asp-page="/CrossProfileAdmin/PrioritisationVariables">Maintain prioritisation variables</a></li>
                        <li class="govuk-footer__list-item"><a class="govuk-footer__link" asp-page="/CrossProfileAdmin/CrossCuttingIssueScores">Maintain cross-cutting issue scores</a></li>
                    </ul>
                </div>
                <div class="govuk-footer__section govuk-grid-column-one-third">
                    <h2 class="govuk-footer__heading govuk-heading-m">Help and support</h2>
                    <ul class="govuk-footer__list">
                        <li class="govuk-footer__list-item"><a class="govuk-footer__link" asp-page="/HelpSupport/HelpUsingD2R2">Help using D2R2</a></li>
                        <li class="govuk-footer__list-item"><a class="govuk-footer__link" asp-page="/HelpSupport/QualityStatement">D2R2 quality statement</a></li>
                    </ul>
                </div>
            </div>
            <hr class="govuk-footer__section-break">
            <div class="govuk-footer__meta">
                <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
                    <h2 class="govuk-visually-hidden">Support links</h2>
                    <ul class="govuk-footer__inline-list">
                        <li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="#">Cookies</a></li>
                        <li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="#">Accessibility statement</a></li>
                        <li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="#">Privacy notice</a></li>
                    </ul>
                    <span class="govuk-footer__licence-description">
                        All content is available under the <a class="govuk-footer__link" href="#" rel="license">Open Government Licence v3.0</a>, except where otherwise stated
                    </span>
                </div>
                <div class="govuk-footer__meta-item">
                    <a class="govuk-footer__link govuk-footer__copyright-logo" href="#">&copy; Crown copyright</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/header-menu.js" asp-append-version="true"></script>
    <script type="module" src="~/js/govuk-frontend-6.5.0.min.js"></script>
    <script type="module">
        import { initAll } from '/js/govuk-frontend-6.5.0.min.js'
        initAll()
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
