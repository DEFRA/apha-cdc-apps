<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1d70b8" />
    <title>@ViewData["Title"] - D2R2</title>

    <link rel="icon" sizes="48x48" href="~/assets/images/favicon.ico" />
    <link rel="icon" sizes="any" href="~/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="~/assets/images/govuk-icon-mask.svg" color="#1d70b8" />
    <link rel="apple-touch-icon" href="~/assets/images/govuk-icon-180.png" />
    <link rel="manifest" href="~/assets/manifest.json" />

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/govuk-frontend-6.5.0.min.css" asp-append-version="true" />
    <!-- Bootstrap is retained only for the not-yet-migrated External user journey; remove once that path adopts GOV.UK Frontend. -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CDC.Web.styles.css" asp-append-version="true" />
</head>
<body class="govuk-template__body" id="top">
    <script>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>
    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>

    <header class="govuk-template__header app-header">
        <!-- Positioned wrapper so the menu panel can overlay the content below it, rather than pushing it down. -->
        <div class="app-header__top">
            <!-- Top bar: application brand (left) and menu/help actions (right). -->
            <div class="app-top-header">
                <div class="app-top-header__container govuk-width-container">
                    <a asp-area="" asp-controller="Landing" asp-action="Index" class="app-top-header__brand-link">
                        <span class="app-top-header__brand">D2R2</span>
                    </a>
                    <div class="app-top-header__actions">
                        <button type="button" id="app-menu-toggle" class="app-top-header__menu-toggle" aria-expanded="false" aria-controls="app-menu-panel">
                            <span class="app-top-header__menu-text">Menu</span>
                            <svg class="app-top-header__menu-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="14" height="8" viewBox="0 0 14 8">
                                <path fill="currentcolor" d="M7 8 0 1l1.4-1.4L7 5.2 12.6-.4 14 1z"/>
                            </svg>
                        </button>
                        <span class="app-top-header__separator" aria-hidden="true"></span>
                        <button type="button" class="app-top-header__help" aria-label="Help">
                            <span class="app-top-header__help-icon" aria-hidden="true">?</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Custom "Menu" toggle panel: intentionally has no data-module="govuk-service-navigation",
                 since the official component only toggles a nav list, not this multi-section panel.
                 Positioned absolutely so it overlays the secondary header and page content instead of pushing them down. -->
            <div id="app-menu-panel" class="app-menu-panel" hidden>
                <partial name="_HeaderMenu" />
            </div>
        </div>

        <!-- Secondary bar: GOV.UK crest + organisation name (left), signed-in user (right). -->
        <div class="app-secondary-header">
            <div class="app-secondary-header__container govuk-width-container">
                <div class="app-secondary-header__brand">
                    <img src="~/assets/images/govuk-crest.svg" alt="GOV.UK" class="app-secondary-header__crest" />
                    <span class="app-secondary-header__org">Animal &amp; Plant Health Agency</span>
                </div>
                <!-- Placeholder until Entra ID sign-in is implemented; username will come from the authenticated user's claims. -->
                <div class="app-secondary-header__account">
                    <p class="app-secondary-header__signed-in">
                        Signed in as: <span class="app-secondary-header__username">Srinivas Bharadwaj Dodla</span>
                    </p>
                    <a href="#" class="app-secondary-header__signout govuk-link govuk-link--no-visited-state">Sign out</a>
                </div>
            </div>
        </div>
    </header>

    <div class="govuk-width-container">
        @await RenderSectionAsync("Breadcrumbs", required: false)
        <main class="govuk-main-wrapper" id="main-content" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="govuk-template__footer app-footer">
        <div class="govuk-width-container govuk-!-padding-top-4 govuk-!-padding-bottom-8">
            <div class="govuk-!-margin-top-2">
                <a class="govuk-link govuk-link--no-visited-state app-footer__back-to-top-link" href="#top">
                    <svg class="app-footer__back-to-top-icon" role="presentation" focusable="false" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="13" height="17" viewBox="0 0 13 17">
                        <path fill="currentColor" d="M6.5 0L0 6.5 1.4 8l4-4v12.7h2V4l4.3 4L13 6.4z"></path>
                    </svg>
                    Back to top
                </a>
            </div>

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-third">
                    <h2 class="govuk-heading-m app-footer__heading govuk-!-margin-top-3 govuk-!-margin-bottom-3 govuk-!-padding-bottom-1">User Admin</h2>
                    <ul class="govuk-list">
                        <li><a class="govuk-link govuk-link--no-visited-state govuk-link--no-underline" asp-page="/UserAdmin/GlobalUsers">Global users</a></li>
                        <li><a class="govuk-link govuk-link--no-visited-state govuk-link--no-underline" asp-page="/UserAdmin/ExternalUsers">External users</a></li>
                    </ul>
                </div>
                <div class="govuk-grid-column-one-third">
                    <h2 class="govuk-heading-m app-footer__heading govuk-!-margin-top-3 govuk-!-margin-bottom-3 govuk-!-padding-bottom-1">Cross Profile Admin</h2>
                    <ul class="govuk-list">
                        <li><a class="govuk-link govuk-link--no-visited-state govuk-link--no-underline" asp-page="/CrossProfileAdmin/ReferenceData">Maintain reference data</a></li>
                        <li><a class="govuk-link govuk-link--no-visited-state govuk-link--no-underline" asp-page="/CrossProfileAdmin/PrioritisationVariables">Maintain prioritisation variables</a></li>
                        <li><a class="govuk-link govuk-link--no-visited-state govuk-link--no-underline" asp-page="/CrossProfileAdmin/CrossCuttingIssueScores">Maintain cross-cutting issue scores</a></li>
                    </ul>
                </div>
                <div class="govuk-grid-column-one-third">
                    <h2 class="govuk-heading-m app-footer__heading govuk-!-margin-top-3 govuk-!-margin-bottom-3 govuk-!-padding-bottom-1">Help and Support</h2>
                    <ul class="govuk-list">
                        <li><a class="govuk-link govuk-link--no-visited-state govuk-link--no-underline" asp-page="/HelpSupport/HelpUsingD2R2">Help using D2R2</a></li>
                        <li><a class="govuk-link govuk-link--no-visited-state govuk-link--no-underline" asp-page="/HelpSupport/QualityStatement">D2R2 Quality Statement</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/header-menu.js" asp-append-version="true"></script>
    <script type="module" src="~/js/govuk-frontend-6.5.0.min.js"></script>
    <script type="module">
        import { initAll } from '/js/govuk-frontend-6.5.0.min.js'
        initAll()
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
