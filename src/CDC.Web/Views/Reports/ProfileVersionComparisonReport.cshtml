@model CDC.Common.Comparison.ProfileVersionComparisonReport
@using CDC.Web.Infrastructure
@using Microsoft.AspNetCore.Html
@{
    // A complete document of its own; the root _ViewStart would otherwise wrap it in the site header and footer.
    Layout = null;
}
@* Rendered to HTML and converted to PDF by Playwright, so styles are inline and nothing is fetched. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Profile version comparison</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #0b0c0c; margin: 0; }
        h1 { font-size: 16px; margin: 0 0 10px; }
        h2 { font-size: 13px; margin: 0 0 10px; padding-bottom: 10px; border-bottom: 1px solid #0b0c0c; }
        .section + .section { break-before: page; }
        .titles { display: flex; margin: 0 0 12px; padding-bottom: 6px; border-bottom: 1px solid #0b0c0c; }
        .titles > div { flex: 1 1 50%; text-align: center; }
        table { width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 6px; }
        thead { display: table-header-group; }
        th, td { border: 1px solid #b1b4b6; padding: 4px 6px; vertical-align: top; text-align: left; word-wrap: break-word; white-space: pre-wrap; }
        th { background: #f3f2f1; white-space: normal; }
        tr { page-break-inside: avoid; }
        .question td, .group td { background: #e8e8e8; font-weight: bold; white-space: normal; }
        .group td { background: #f3f2f1; font-weight: normal; font-style: italic; }
        .removed { color: #d4351c; text-decoration: line-through; }
        .added { color: #005a30; font-weight: bold; text-decoration: underline; }
        .key { margin: 0 0 8px; }
        .identical { text-align: center; font-style: italic; margin: 4px 0 10px; }
        .none { text-align: center; font-style: italic; }
        .options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px 10px; margin: 0; padding: 0; list-style: none; white-space: normal; }
        .options li { display: flex; align-items: center; }
        .checkbox { position: relative; display: inline-block; flex: none; width: 11px; height: 11px; margin-right: 4px; border: 1px solid #0b0c0c; }
        .checkbox--selected::after { content: ''; position: absolute; left: 3px; top: -1px; width: 3px; height: 8px; border: solid #0b0c0c; border-width: 0 2px 2px 0; transform: rotate(45deg); }
    </style>
</head>
<body>
    <h1>Profile version comparison</h1>
    <p class="key"><span class="removed">Struck-through text</span> was removed. <span class="added">Bold underlined text</span> was added.</p>

    @if (Model.Sections.All(item => item.IsIdentical))
    {
        <p class="none">The two profile versions are identical.</p>
    }

    @foreach (var part in Model.Sections)
    {
        @* As the legacy report, each section starts on its own page under the two version titles. *@
        <div class="section">
        <div class="titles">
            <div>@Model.LeftTitle</div>
            <div>@Model.RightTitle</div>
        </div>
        <h2>@part.Heading</h2>

        @if (part.IsIdentical)
        {
            <p class="identical">- Sections are identical -</p>
        }
        else
        {
        <table>
            <thead>
                <tr>
                    <th scope="col" style="width:20%">Question</th>
                    <th scope="col" style="width:40%">@Model.LeftTitle</th>
                    <th scope="col" style="width:40%">@Model.RightTitle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var question in part.Questions)
                {
                    <tr class="question">
                        <td colspan="3">@question.Number @question.Text</td>
                    </tr>
                    @foreach (var group in question.Groups)
                    {
                        @if (group.Heading is not null)
                        {
                            <tr class="group">
                                <td colspan="3">@group.Heading</td>
                            </tr>
                        }
                        @foreach (var field in group.Fields)
                        {
                            <tr>
                                <td>@field.Label</td>
                                <td>@Answer(field.LeftOptions, field.Left)</td>
                                <td>@Answer(field.RightOptions, field.Right)</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
        }
        </div>
    }
</body>
</html>

@functions {
    private static IHtmlContent Answer(IReadOnlyList<CDC.Common.Comparison.ComparisonOption>? options, IReadOnlyList<CDC.Common.Comparison.ComparisonSegment> segments)
    {
        if (options is null)
        {
            return ComparisonHtml.Render(segments);
        }

        var list = new TagBuilder("ul");
        list.AddCssClass("options");

        foreach (var option in options)
        {
            var item = new TagBuilder("li");
            var checkbox = new TagBuilder("span");
            checkbox.AddCssClass(option.Selected ? "checkbox checkbox--selected" : "checkbox");

            var text = new TagBuilder("span");
            text.InnerHtml.Append(option.Text);

            item.InnerHtml.AppendHtml(checkbox);
            item.InnerHtml.AppendHtml(text);
            list.InnerHtml.AppendHtml(item);
        }

        return list;
    }
}
