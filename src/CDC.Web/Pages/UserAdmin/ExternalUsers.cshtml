@page
@model CDC.Web.Pages.UserAdmin.ExternalUsersModel
@{
    ViewData["Title"] = "External users";
}
@section Breadcrumbs {
    <partial name="_Breadcrumb" model="Model.Breadcrumb" />
}

<h1 class="govuk-heading-l">External users</h1>
<p class="govuk-body">
    External user accounts. Change whether a user receives review notification emails when a
    section they contribute to is due review.
</p>

@if (Model.SuccessMessage is not null)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="external-users-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="external-users-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.SuccessMessage</p>
        </div>
    </div>
}

@if (Model.HasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="external-users-error-summary-title">
        <div role="alert">
            <h2 class="govuk-error-summary__title" id="external-users-error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <p class="govuk-body">Unable to load the external user list. Try again later.</p>
            </div>
        </div>
    </div>
}
else if (Model.Users.Count == 0)
{
    <p class="govuk-body">There are no external users.</p>
}
else
{
    var table = new UserSubscriptionTableViewModel(
        "external",
        "External users and their review email subscriptions",
        ShowEmailAddress: true,
        Model.Users);

    <partial name="_UserSubscriptionTable" model="table" />
}
