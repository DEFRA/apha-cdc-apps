@page "{profileId:guid}"
@model CDC.Web.Pages.SurveillanceProfiles.EditProfileReviewCommentsModel
@{
    Layout = "_ProfileSectionTabLayout";
}
@if (Model.CurrentSection is not null)
{
    var tabsModel = Model.BuildTabs();

    <div class="govuk-tabs app-tab-carousel">
        <partial name="_ProfileSectionTabs" model="tabsModel" />
        <div class="govuk-tabs__panel" id="profile-review-comments-panel">
            @if (Model.ReviewComments.Count == 0)
            {
                <p class="govuk-body">There are no review comments to display.</p>
            }
            else
            {
                <table class="govuk-table">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">Subject</th>
                            <th scope="col" class="govuk-table__header">Reference</th>
                            <th scope="col" class="govuk-table__header">Comment</th>
                            <th scope="col" class="govuk-table__header">By</th>
                            <th scope="col" class="govuk-table__header">Date</th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @foreach (var comment in Model.ReviewComments)
                        {
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">@Html.Raw(comment.IndentedSubject)</td>
                                <td class="govuk-table__cell">@comment.CommentReference</td>
                                <td class="govuk-table__cell">@comment.CommentText</td>
                                <td class="govuk-table__cell">@comment.UserFullName</td>
                                <td class="govuk-table__cell">@comment.CommentDate</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
