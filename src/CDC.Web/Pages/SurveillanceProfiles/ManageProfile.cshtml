@page "{profileId:guid}"
@model CDC.Web.Pages.SurveillanceProfiles.ManageProfileModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.Profile is not null ? $"Manage profile: {Model.Profile.ProfileTitle}" : "Manage profile";
}

@section Breadcrumbs {
    <div class="govuk-breadcrumbs">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" asp-area="" asp-controller="Landing" asp-action="Index">D2R2 Home</a>
            </li>
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" asp-area="" asp-page="/SurveillanceProfiles/Search">Search disease profiles</a>
            </li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">
                Manage
            </li>
        </ol>
    </div>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        @if (Model.Profile is not null)
        {
            <h1 class="govuk-heading-l">Manage profile:<br />@CDC.Web.Infrastructure.ProfileTitleHtmlFormatter.Format(Model.Profile.ProfileTitle)</h1>
        }
        else
        {
            <h1 class="govuk-heading-l">Manage profile</h1>
        }

        @if (Model.HasError)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body">Unable to load this profile. Please try again.</p>
                    </div>
                </div>
            </div>
        }
        else if (Model.Profile is not null)
        {
            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="app-manage-profile-status-success-title" data-module="govuk-notification-banner">
                    <div class="govuk-notification-banner__header">
                        <h2 class="govuk-notification-banner__title" id="app-manage-profile-status-success-title">Success</h2>
                    </div>
                    <div class="govuk-notification-banner__content">
                        <p class="govuk-notification-banner__heading">@Model.StatusMessage</p>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(Model.StatusErrorMessage))
            {
                <div class="govuk-notification-banner" role="alert" aria-labelledby="app-manage-profile-status-error-title" data-module="govuk-notification-banner">
                    <div class="govuk-notification-banner__header">
                        <h2 class="govuk-notification-banner__title" id="app-manage-profile-status-error-title">Important</h2>
                    </div>
                    <div class="govuk-notification-banner__content">
                        <p class="govuk-notification-banner__heading">@Model.StatusErrorMessage</p>
                    </div>
                </div>
            }

            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Profile title</dt>
                    <dd class="govuk-summary-list__value">@CDC.Web.Infrastructure.ProfileTitleHtmlFormatter.Format(Model.Profile.ProfileTitle)</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Scenario title</dt>
                    <dd class="govuk-summary-list__value">@Model.Profile.ScenarioTitle</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Latest published version (public)</dt>
                    <dd class="govuk-summary-list__value">@Model.Profile.LatestPublishedVersionPublic</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Latest published version (DefraNet only)</dt>
                    <dd class="govuk-summary-list__value">
                        @Model.Profile.LatestPublishedVersionDefraNetOnly
                        @if (Model.Profile.LinkVisibility.CanAllowPublicAccess)
                        {
                            <a class="govuk-link govuk-!-margin-left-3" asp-page="./AllowPublicAccess" asp-route-profileId="@Model.ProfileId">Allow public access</a>
                        }
                    </dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Latest draft version</dt>
                    <dd class="govuk-summary-list__value">@Model.Profile.LatestDraftVersion</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Profile status</dt>
                    <dd class="govuk-summary-list__value">
                        <form method="post">
                            <input type="hidden" asp-for="ProfileId" />
                            <div class="govuk-form-group govuk-!-margin-bottom-0">
                                <label class="govuk-visually-hidden" for="ProfileStatusId">Profile status</label>
                                <select class="govuk-select" asp-for="ProfileStatusId" asp-items="@(new SelectList(Model.ProfileStatusTypes, nameof(ProfileStatusTypeDto.Id), nameof(ProfileStatusTypeDto.Name)))" onchange="this.form.requestSubmit()">
                                    <option value="">Please select...</option>
                                </select>
                            </div>
                        </form>
                    </dd>
                </div>
            </dl>

            <ul class="govuk-list">
                @if (Model.Profile.LinkVisibility.CanEditProperties)
                {
                    <li>
                        <a class="govuk-link" asp-page="./EditProperties" asp-route-profileId="@Model.ProfileId">Edit properties</a>
                    </li>
                }
                @if (Model.Profile.LinkVisibility.CanMaintainContributorsAndReviewers)
                {
                    <li>
                        <a class="govuk-link" asp-page="./MaintainContributorsAndReviewers" asp-route-profileId="@Model.ProfileId">Maintain contributors and reviewers</a>
                    </li>
                }
                @if (Model.Profile.LinkVisibility.CanViewContributionsReport)
                {
                    <li>
                        <a class="govuk-link" asp-page="./ViewContributionsReport" asp-route-profileId="@Model.ProfileId">View contributions report</a>
                    </li>
                }
                @if (Model.Profile.LinkVisibility.CanCreateNewDraftVersion)
                {
                    <li>
                        <button type="button" class="govuk-link app-link-button" data-confirm-target="#confirmCreateNewDraftVersionModal">Create new draft version @Model.Profile.NewDraftVersionLabel</button>
                    </li>
                }
                @if (Model.Profile.LinkVisibility.CanDeleteCurrentVersion)
                {
                    <li>
                        <a class="govuk-link" asp-page="./DeleteCurrentVersion" asp-route-profileId="@Model.ProfileId">Delete current version</a>
                    </li>
                }
                @if (Model.Profile.LinkVisibility.CanCloneNewProfile)
                {
                    <li>
                        <a class="govuk-link" asp-page="./CloneNewProfile" asp-route-profileId="@Model.ProfileId">Clone new profile</a>
                    </li>
                }
                @if (Model.Profile.LinkVisibility.CanCloneNewScenario)
                {
                    <li>
                        <a class="govuk-link" asp-page="./CloneNewScenario" asp-route-profileId="@Model.ProfileId">Clone new scenario</a>
                    </li>
                }
                @if (Model.Profile.LinkVisibility.CanPublishPublic)
                {
                    <li>
                        <a class="govuk-link" asp-page="./PublishPublic" asp-route-profileId="@Model.ProfileId">Publish (public)</a>
                    </li>
                }
                @if (Model.Profile.LinkVisibility.CanPublishDefranetOnly)
                {
                    <li>
                        <a class="govuk-link" asp-page="./PublishDefranetOnly" asp-route-profileId="@Model.ProfileId">Publish (Defranet only)</a>
                    </li>
                }
            </ul>

            @if (Model.Profile.LinkVisibility.CanCreateNewDraftVersion)
            {
                <partial name="_ConfirmActionModal" model="@(new ConfirmActionModalViewModel(
                    "confirmCreateNewDraftVersionModal",
                    "Are you sure you want to perform this action?",
                    "Are you sure you want to create a new draft version?",
                    "CreateNewDraftVersion",
                    Model.ProfileId))" />
            }
        }
    </div>
</div>
