@page "{profileId:guid}"
@model CDC.Web.Pages.SurveillanceProfiles.EditProfileQuestionsModel
@using CDC.Web.Infrastructure
@using CDC.Web.Pages.SurveillanceProfiles
@{
    Layout = "_ProfileSectionTabLayout";

    var accordionModel = new QuestionEditAccordionViewModel(
        EditProfileQuestionsModel.AccordionIdPrefix,
        "No questions are available for this section.",
        Model.Questions);
}
@if (Model.CurrentSection is not null)
{
    var tabsModel = Model.BuildTabs("NavigateTab");

    <form method="post">
        <input type="hidden" name="profileVersionId" value="@Model.CurrentProfileVersionId" />
        <input type="hidden" name="Section" value="@Model.CurrentSection.Id" />
        <input type="hidden" name="lastUpdated" value="@Model.SectionLastUpdated" />

        @if (Model.CanEditProfileSection || Model.CanClearProfileSection || Model.CanPrintProfileSection)
        {
            <div class="govuk-button-group app-button-group--right">
                @if (Model.CanEditProfileSection)
                {
                    <button type="submit" asp-page-handler="SaveSection" class="govuk-button" data-module="govuk-button">Save</button>
                    <button type="submit" asp-page-handler="ValidateSection" class="govuk-button" data-module="govuk-button">Validate</button>
                }
                @if (Model.CanClearProfileSection)
                {
                    @* As the legacy btnClearSection did, asks before clearing; the confirmation dialog is outside this form, which it cannot nest in. *@
                    <button type="button" class="govuk-button govuk-button--warning" data-module="govuk-button" data-confirm-target="#clear-section-dialog">Clear</button>
                }
                @if (Model.CanPrintProfileSection)
                {
                    @* As the legacy btnPrintSection did, prints just this section's saved answers, in a new tab so an error page cannot lose unsaved edits. *@
                    <a href="@Model.BuildPrintUrl(Model.CurrentSection.Id)" draggable="false" class="govuk-button govuk-button--secondary" data-module="govuk-button" target="_blank" rel="noopener noreferrer">Print<span class="govuk-visually-hidden"> this section (opens in new tab)</span></a>
                }
            </div>
        }

        @if (Model.HasValidated && Model.InvalidReasons.Count > 0)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="section-validation-error-summary-title">
                <div role="alert">
                    <h2 class="govuk-error-summary__title" id="section-validation-error-summary-title">@(Model.InvalidReasons.Count == 1 ? "There is 1 validation error" : $"There are {Model.InvalidReasons.Count} validation errors")</h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            @foreach (var reason in Model.InvalidReasons)
                            {
                                var reasonUrl = Model.BuildValidationReasonUrl(reason);
                                var reasonText = EditProfileQuestionsModel.BuildValidationReasonText(reason);

                                <li>
                                    @if (reasonUrl is null)
                                    {
                                        @reasonText
                                    }
                                    else
                                    {
                                        <a href="@reasonUrl">@reasonText</a>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
        else if (Model.HasValidated)
        {
            <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="section-validation-success-title" data-module="govuk-notification-banner">
                <div class="govuk-notification-banner__header">
                    <h2 class="govuk-notification-banner__title" id="section-validation-success-title">Success</h2>
                </div>
                <div class="govuk-notification-banner__content">
                    <p class="govuk-notification-banner__heading">This section has no validation errors.</p>
                </div>
            </div>
        }

        @if (Model.ActionMessage is not null)
        {
            if (Model.ActionMessageIsError)
            {
                <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="section-action-error-title">
                    <div role="alert">
                        <h2 class="govuk-error-summary__title" id="section-action-error-title">There is a problem</h2>
                        <div class="govuk-error-summary__body">
                            <p class="govuk-body">@Model.ActionMessage</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="section-action-success-title" data-module="govuk-notification-banner">
                    <div class="govuk-notification-banner__header">
                        <h2 class="govuk-notification-banner__title" id="section-action-success-title">Success</h2>
                    </div>
                    <div class="govuk-notification-banner__content">
                        <p class="govuk-notification-banner__heading">@Model.ActionMessage</p>
                    </div>
                </div>
            }
        }

        @if (Model.SaveValidationErrors.Count > 0)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="section-save-error-summary-title">
                <div role="alert">
                    <h2 class="govuk-error-summary__title" id="section-save-error-summary-title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            @foreach (var error in Model.SaveValidationErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <div class="govuk-tabs app-tab-carousel">
            <partial name="_ProfileSectionTabs" model="tabsModel" />
            <div class="govuk-tabs__panel" id="profile-questions-panel">
                @if (Model.HasNoVersion)
                {
                    <div class="govuk-inset-text">This profile has no current version to browse.</div>
                }
                else
                {
                    <partial name="_ProfileQuestionEditAccordion" model="accordionModel" />

                    if (Model.CanEditProfileSection)
                    {
                        @* As the legacy btnSave2 and btnValidateSection2 did, repeats the Save and Validate buttons below the questions. *@
                        <div class="govuk-button-group govuk-!-margin-top-6">
                            <button type="submit" asp-page-handler="SaveSection" class="govuk-button" data-module="govuk-button">Save</button>
                            <button type="submit" asp-page-handler="ValidateSection" class="govuk-button" data-module="govuk-button">Validate</button>
                        </div>
                    }
                }
            </div>
        </div>
    </form>

    @if (Model.CanClearProfileSection)
    {
        <dialog class="app-modal" id="clear-section-dialog" aria-labelledby="clear-section-dialog-title">
            <h2 class="govuk-heading-m" id="clear-section-dialog-title">Confirm</h2>
            <p class="govuk-body">Are you sure you want to clear all the data from this section?</p>
            <form method="post" asp-page-handler="ClearSection">
                <input type="hidden" name="profileVersionId" value="@Model.CurrentProfileVersionId" />
                <input type="hidden" name="Section" value="@Model.CurrentSection.Id" />
                <input type="hidden" name="lastUpdated" value="@Model.SectionLastUpdated" />
                <button type="submit" class="govuk-button govuk-!-margin-bottom-0 govuk-!-margin-right-2">Ok</button>
                <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-confirm-close>Cancel</button>
            </form>
        </dialog>
    }
}

@section Scripts {
    <script src="~/js/richtext-toolbar.js" asp-append-version="true"></script>
    <script src="~/js/spell-check.js" asp-append-version="true"></script>
}
