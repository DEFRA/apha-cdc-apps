@page
@model CDC.Web.Pages.SurveillanceProfiles.ViewProfileGuidanceReportModel
@{
    ViewData["Title"] = "Error: Guidance report";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @if (Model.ErrorMessage is not null)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="guidance-report-error-title">
                <div role="alert">
                    <h2 class="govuk-error-summary__title" id="guidance-report-error-title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body">@Model.ErrorMessage</p>
                    </div>
                </div>
            </div>
        }

        <a class="govuk-link" asp-page="/SurveillanceProfiles/EditUserGuidance">Back to edit questions and guidance</a>
    </div>
</div>
