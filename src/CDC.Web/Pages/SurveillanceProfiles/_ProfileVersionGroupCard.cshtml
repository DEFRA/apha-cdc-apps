@model CDC.Web.Pages.ProfileVersionGroupViewModel
@* One version-lineage card: the profile's own Published card, its own Draft card, or one
   independent "what-if" scenario's - never merged with any other lineage's history. *@

<div class="app-profile-card__sub-card">
    @if (Model.NoVersionMessage is not null)
    {
        <p class="govuk-body govuk-!-margin-bottom-1">
            <strong>@Model.CurrentVersionLabel: @Model.NoVersionMessage</strong>
        </p>
    }
    else
    {
        @if (Model.CurrentVersion is not null)
        {
            <p class="govuk-body govuk-!-margin-bottom-1">
                <strong>@Model.CurrentVersionLabel: @($"{Model.CurrentVersion.VersionNumber}.{Model.CurrentVersion.VersionMinor}")</strong>
                <span class="govuk-!-margin-left-2">@Model.CurrentVersion.CreatedAtUtc.ToString("dd/MM/yyyy")</span> -
            </p>
        }

        <p class="govuk-body govuk-!-margin-bottom-1">
            @if (Model.ShowViewReportsLink)
            {
                <a class="govuk-link" href="#">View reports</a>
                <span aria-hidden="true"> | </span>
            }
            <a class="govuk-link" href="#">Clone profile</a>
            <span aria-hidden="true"> | </span>
            <a class="govuk-link" asp-page="/SurveillanceProfiles/EditProfileQuestions" asp-route-profileId="@Model.ProfileId">Browse profile</a>
            <span aria-hidden="true"> | </span>
            <a class="govuk-link" href="#">Clone scenario</a>
        </p>

        @if (Model.ProfileStatus is not null)
        {
            <p class="govuk-body govuk-!-margin-bottom-1">Profile Status: @Model.ProfileStatus</p>
        }

        <div data-module="app-filters-toggle">
            <button type="button" class="govuk-link app-species-filter__toggle" data-app-filters-toggle-link
                    data-app-filters-expanded-text="Hide previous versions"
                    data-app-filters-collapsed-text="Show previous versions"
                    aria-expanded="false" aria-controls="previous-versions-@Model.SectionId">
                <span data-app-filters-toggle-text>Show previous versions</span>
                <span class="app-species-filter__icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 8" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <path d="M1 1l5 5 5-5" />
                    </svg>
                </span>
            </button>

            <div id="previous-versions-@Model.SectionId" class="app-filters__content govuk-!-margin-top-2" hidden>
                <div class="app-profile-card__sub-card app-profile-card__sub-card--secondary">
                    @if (Model.VersionHistory.Count == 0)
                    {
                        <p class="govuk-body govuk-!-margin-bottom-0">No previous versions.</p>
                    }
                    else
                    {
                        @foreach (var row in Model.VersionHistory)
                        {
                            <div class="app-profile-card__version-row">
                                <p class="govuk-body govuk-!-margin-bottom-0 app-profile-card__version-detail">
                                    <span class="app-profile-card__version-number">Version @($"{row.Version.VersionNumber}.{row.Version.VersionMinor}")</span>
                                    <span class="app-profile-card__version-status">@row.Status</span>
                                    <span class="app-profile-card__version-dates">@row.Version.CreatedAtUtc.ToString("dd/MM/yyyy") - @row.Version.EffectiveToUtc?.ToString("dd/MM/yyyy")</span>
                                </p>
                                <p class="govuk-body govuk-!-margin-bottom-0 app-profile-card__version-actions">
                                    @if (row.ShowViewReportsLink)
                                    {
                                        <a class="govuk-link" href="#">View reports</a>
                                        <span aria-hidden="true"> | </span>
                                    }
                                    <a class="govuk-link" href="#">Clone profile</a>
                                    <span aria-hidden="true"> | </span>
                                    <a class="govuk-link" asp-page="/SurveillanceProfiles/EditProfileQuestions" asp-route-profileId="@Model.ProfileId">Browse profile</a>
                                    <span aria-hidden="true"> | </span>
                                    <a class="govuk-link" href="#">Clone scenario</a>
                                </p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>
