@model CDC.Web.Pages.SurveillanceProfilesSearchModel
@inject CDC.Web.Authorization.Services.INavigationAuthorizationService NavigationAuthorization
@* Rendered both by the full page and, via SurveillanceProfilesSearchModel.OnGetAsync, as an
   AJAX fragment so filter changes can repopulate this section without a full page reload. *@
@{
    var canEditProfile = await NavigationAuthorization.CanEditProfileAsync(User);
    var canCreateProfile = await NavigationAuthorization.CanCreateProfileAsync(User);
    var canViewContributionsReport = await NavigationAuthorization.CanViewContributionsReportAsync(User);
}

<input type="hidden" id="PageNumber" name="PageNumber" value="@Model.PageNumber" form="search-form" />

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="govuk-error-summary govuk-!-margin-top-4" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <p>@Model.ErrorMessage</p>
            </div>
        </div>
    </div>
}

@if (Model.IsSearchPerformed)
{
    <div class="govuk-grid-row govuk-!-margin-top-4">
        <div class="govuk-grid-column-full">
            <p class="govuk-body govuk-!-margin-bottom-2">
                <strong>@Model.TotalResultCount</strong> disease profile(s) found containing the search words (phrase) you entered
            </p>
            <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--m govuk-!-margin-top-0" />

            @if (Model.SearchResults.Count == 0)
            {
                <p class="govuk-body">
                    No disease profiles match your search criteria. Please try different search terms or filter options.
                </p>
            }
            else
            {
                <div class="app-results-toolbar govuk-!-margin-bottom-3">
                    <div class="govuk-form-group govuk-!-margin-bottom-0">
                        <label class="govuk-label" for="SortBy">Sort by:</label>
                        <select class="govuk-select" id="SortBy" name="SortBy" form="search-form" onchange="this.form.requestSubmit()">
                            @foreach (var option in CDC.Web.Pages.SurveillanceProfilesSearchModel.SortByOptions)
                            {
                                <option value="@option.Value" selected="@(option.Value == Model.SortBy ? "selected" : null)">@option.Text</option>
                            }
                        </select>
                    </div>

                    <div class="govuk-form-group govuk-!-margin-bottom-0">
                        <label class="govuk-label" for="PageSize">Items per page:</label>
                        <select class="govuk-select" id="PageSize" name="PageSize" form="search-form" onchange="this.form.requestSubmit()">
                            @foreach (var option in CDC.Web.Pages.SurveillanceProfilesSearchModel.PageSizeOptions)
                            {
                                <option value="@option" selected="@(option == Model.PageSize ? "selected" : null)">@option</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="app-profile-list">
                    @foreach (var profile in Model.PagedResults)
                    {
                        var scenarioSections = Model.GetScenarioSections(profile);

                        <div class="app-profile-card govuk-!-margin-bottom-3">
                            <div class="app-profile-card__header">
                                <h3 class="govuk-heading-s govuk-!-margin-bottom-0">@CDC.Web.Infrastructure.ProfileTitleHtmlFormatter.Format(profile.Title)</h3>
                                <p class="govuk-body govuk-!-margin-bottom-0">
                                    @if (canEditProfile)
                                    {
                                        <a class="govuk-link" asp-page="/SurveillanceProfiles/EditProfileTitle" asp-route-profileId="@profile.Id">Edit Title</a>
                                    }
                                    @* With scenarios shown, Manage and Contributions are offered per scenario below, not here. *@
                                    @if (!Model.DisplayScenarios)
                                    {
                                        @if (canEditProfile)
                                        {
                                            <span aria-hidden="true"> | </span>
                                            <a class="govuk-link" asp-page="/SurveillanceProfiles/ManageProfile" asp-route-profileId="@profile.Id">Manage</a>
                                        }
                                        @if (canViewContributionsReport)
                                        {
                                            @if (canEditProfile)
                                            {
                                                <span aria-hidden="true"> | </span>
                                            }
                                            <a class="govuk-link" asp-page="/SurveillanceProfiles/ViewContributionsReport" asp-route-profileId="@profile.Id">Contributions</a>
                                        }
                                    }
                                </p>
                            </div>

                            @foreach (var scenario in scenarioSections)
                            {
                                @if (Model.DisplayScenarios)
                                {
                                    var scenarioName = CDC.Web.Infrastructure.ProfileTitleHtmlFormatter.ToPlainText(scenario.Title);

                                    <div class="app-profile-card__header govuk-!-margin-bottom-2">
                                        <h4 class="govuk-heading-s govuk-!-margin-bottom-0">@CDC.Web.Infrastructure.ProfileTitleHtmlFormatter.Format(scenario.Title)</h4>
                                        <p class="govuk-body govuk-!-margin-bottom-0">
                                            @if (canEditProfile)
                                            {
                                                <a class="govuk-link" asp-page="/SurveillanceProfiles/ManageProfile" asp-route-profileId="@scenario.ScenarioId">Manage<span class="govuk-visually-hidden"> @scenarioName</span></a>
                                            }
                                            @if (canViewContributionsReport)
                                            {
                                                @if (canEditProfile)
                                                {
                                                    <span aria-hidden="true"> | </span>
                                                }
                                                <a class="govuk-link" asp-page="/SurveillanceProfiles/ViewContributionsReport" asp-route-profileId="@scenario.ScenarioId">Contributions<span class="govuk-visually-hidden"> @scenarioName</span></a>
                                            }
                                        </p>
                                    </div>
                                }

                                <div class="@(Model.DisplayScenarios ? "govuk-!-margin-left-6 govuk-!-margin-bottom-4" : null)">
                                    @for (var index = 0; index < scenario.Groups.Count; index++)
                                    {
                                        var card = scenario.Groups[index] with { CanClone = canCreateProfile };

                                        <div class="@(index > 0 ? "govuk-!-margin-top-1" : string.Empty)">
                                            <partial name="_ProfileVersionGroupCard" model="card" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                var pagination = new PaginationViewModel
                {
                    CurrentPage = Model.PageNumber,
                    TotalPages = Model.TotalPages,
                    PageUrl = Model.BuildPageUrl,
                    LandmarkLabel = "Search results pages",
                    AddPageData = true
                };
                <partial name="_Pagination" model="pagination" />
            }
        </div>
    </div>
}
