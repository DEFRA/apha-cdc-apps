@page "{speciesId:guid}"
@model CDC.Web.Pages.EditSpeciesModel
@{
    var speciesLabel = Model.SpeciesName?.ToLowerInvariant();
    var pageHeading = Model.Edit ? "Edit species data" : "View species data";
    ViewData["Title"] = speciesLabel is null ? pageHeading : $"{pageHeading} - {speciesLabel}";

    var subnavModel = new SectionSubnavViewModel(
        "Species data sections",
        [.. CDC.Web.Models.EditSpeciesSectionCatalog.Sections
            .Select(navSection => new SectionNavItem(
                navSection.Number,
                navSection.Title,
                Model.BuildSectionUrl(navSection.Key),
                navSection.Key == Model.CurrentSection.Key))]);

    var accordionModel = new QuestionAccordionViewModel(
        "species-accordion",
        "No sub-sections are available for this section.",
        Model.Questions);

    var previousNavItem = Model.PreviousSection is null
        ? null
        : new SectionNavItem(Model.PreviousSection.Number, Model.PreviousSection.Title, Model.BuildSectionUrl(Model.PreviousSection.Key));
    var nextNavItem = Model.NextSection is null
        ? null
        : new SectionNavItem(Model.NextSection.Number, Model.NextSection.Title, Model.BuildSectionUrl(Model.NextSection.Key));
    var paginationModel = new SectionPaginationViewModel(previousNavItem, nextNavItem);
}
@section Breadcrumbs {
    <div class="govuk-breadcrumbs">
        <ol class="govuk-breadcrumbs__list">
            <li class="govuk-breadcrumbs__list-item">
                <a class="govuk-breadcrumbs__link" asp-area="" asp-controller="Landing" asp-action="Internal">D2R2 Home</a>
            </li>
            <li class="govuk-breadcrumbs__list-item">
                @if (Model.Edit)
                {
                    <a class="govuk-breadcrumbs__link" asp-page="/SpeciesData/Maintain">Maintain species data</a>
                }
                else
                {
                    <a class="govuk-breadcrumbs__link" asp-page="/ViewSpeciesData">View species data</a>
                }
            </li>
            <li class="govuk-breadcrumbs__list-item" aria-current="page">@ViewData["Title"]</li>
        </ol>
    </div>
}

@if (Model.HasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="species-detail-error-summary-title">
        <div role="alert">
            <h2 class="govuk-error-summary__title" id="species-detail-error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <p class="govuk-body">We could not load this species. Try again later.</p>
            </div>
        </div>
    </div>
}
else
{
    <h1 class="govuk-heading-l">@pageHeading - @speciesLabel</h1>

    @if (Model.SuccessMessage is not null)
    {
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="species-data-success-title" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title" id="species-data-success-title">Success</h2>
            </div>
            <div class="govuk-notification-banner__content">
                <p class="govuk-notification-banner__heading">@Model.SuccessMessage</p>
            </div>
        </div>
    }

    @if (Model.SaveErrorMessage is not null)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="species-data-save-error-title">
            <div role="alert">
                <h2 class="govuk-error-summary__title" id="species-data-save-error-title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <p class="govuk-body">@Model.SaveErrorMessage</p>
                </div>
            </div>
        </div>
    }

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-quarter">
            <partial name="_SectionSubnav" model="subnavModel" />
        </div>
        <div class="govuk-grid-column-three-quarters">
            <div class="app-species-tabs">
                <span class="app-species-tabs__tab app-species-tabs__tab--active">@Model.CurrentSection.Title</span>
            </div>

            <div class="app-species-panel">
                @if (Model.Edit)
                {
                    <partial name="_EditSpeciesQuestionForm" model="Model" />
                }
                else
                {
                    <partial name="_QuestionAccordion" model="accordionModel" />
                }
            </div>

            <partial name="_SectionPagination" model="paginationModel" />
        </div>
    </div>
}
