@page
@model CDC.Web.Pages.HelpSupport.DocumentHistoryModel
@{
    ViewData["Title"] = $"History for {Model.SelectedDocumentTitle}";
}
@section Breadcrumbs {
    <partial name="_Breadcrumb" model="Model.Breadcrumb" />
}

<h1 class="govuk-heading-l">History for @Model.SelectedDocumentTitle</h1>

<p class="govuk-body">Below is a list of published versions of this user manual. These manuals have been created to help D2R2 users. If you have any suggestions for improving the manual system, then you can contact us using the following email address: <a class="govuk-link" href="mailto:D2R2@defra.gov.uk">D2R2@defra.gov.uk</a></p>

@if (Model.HasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert">
        <h2 class="govuk-error-summary__title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <p class="govuk-body">We could not load the version history. Try again later.</p>
        </div>
    </div>
}

@if (!Model.HasError)
{
    <div class="govuk-grid-row govuk-!-margin-bottom-3">
        <div class="govuk-grid-column-full govuk-!-text-align-right">
            <form method="get" class="govuk-!-margin-bottom-0">
                <div class="govuk-form-group govuk-!-margin-bottom-0">
                    <label class="govuk-label govuk-!-display-inline" for="PageSize">Items per page:</label>
                    <select class="govuk-select govuk-!-display-inline" id="PageSize" name="pageSize" style="min-width: 5rem; width: 5rem;" onchange="this.form.submit()">
                        @foreach (var option in CDC.Web.Pages.HelpSupport.DocumentHistoryModel.PageSizeOptions)
                        {
                            <option value="@option" selected="@(option == Model.PageSize ? "selected" : null)">@option</option>
                        }
                    </select>
                </div>
                <input type="hidden" name="staticReportId" value="@Model.StaticReportId" />
                <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
                <input type="hidden" name="pageNumber" value="1" />
            </form>
        </div>
    </div>
}

<table id="manual-history-table" class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Title</th>
            <th scope="col" class="govuk-table__header" aria-sort="@(Model.SortOrder == "desc" ? "descending" : "ascending")">
                <a id="manual-history-sort-toggle" class="govuk-link" href="@Model.BuildSortUrl()">
                    Version <span aria-hidden="true">@(Model.SortOrder == "desc" ? "▼" : "▲")</span>
                    <span class="govuk-visually-hidden">@(Model.SortOrder == "desc" ? "sorted descending, select to sort ascending" : "sorted ascending, select to sort descending")</span>
                </a>
            </th>
            <th scope="col" class="govuk-table__header">Effective dates</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var version in Model.Versions)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                    <a class="govuk-link" asp-page="/HelpSupport/HelpUsingD2R2" asp-page-handler="Download" asp-route-documentId="@version.Id" target="_blank" rel="noopener noreferrer">@version.Title</a>
                </td>
                <td class="govuk-table__cell">@version.Version</td>
                <td class="govuk-table__cell">@version.EffectiveDateRange</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <partial name="_Pagination" model='new PaginationViewModel(Model.PageNumber, Model.TotalPages, Model.BuildPageUrl, "Manual history pages")' />
}

