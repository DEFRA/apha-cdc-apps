@page
@model CDC.Web.Pages.HelpSupport.QualityStatementModel
@{
    ViewData["Title"] = "D2R2 Quality Statement";
}
@section Breadcrumbs {
    <partial name="_Breadcrumb" model="Model.Breadcrumb" />
}

@* On success OnGetAsync returns a File result and this view never renders; it only renders
   when the CDC.Api call failed, so there is nothing to show here but the error banner. *@
<div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="quality-statement-error-summary-title">
    <div role="alert">
        <h2 class="govuk-error-summary__title" id="quality-statement-error-summary-title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <p class="govuk-body">@Model.ErrorMessage</p>
        </div>
    </div>
</div>
