@page
@model CDC.Web.Pages.HelpSupport.StaticReportsModel
@{
    ViewData["Title"] = Model.Breadcrumb.PageName;
}
@section Breadcrumbs {
    <partial name="_Breadcrumb" model="Model.Breadcrumb" />
}

<h1 class="govuk-heading-l">@Model.Breadcrumb.PageName</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="app-static-reports-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="app-static-reports-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.SuccessMessage</p>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="govuk-notification-banner" role="alert" aria-labelledby="app-static-reports-error-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="app-static-reports-error-title">Important</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.ErrorMessage</p>
        </div>
    </div>
}

@if (Model.IsHistoryMode)
{
    <p class="govuk-body">
        Below is a list of published versions of this @(Model.IsUserManual ? "user manual" : "report"). These have been generated from
        information held within the D2R2 Database. If you have any suggestions for improving the manual system, then you can contact us
        using the following email address: <a class="govuk-link" href="mailto:D2R2@defra.gov.uk">D2R2@defra.gov.uk</a>
    </p>
}
else if (Model.IsUserManual)
{
    <p class="govuk-body">
        Below is a list of manuals for using D2R2. Each manual has been tailored according to the particular privileges
        that you may have as a user of D2R2. Please click on the title of any of the manuals to open the document.
        If you have any general questions or suggestions for improving the system, then you can contact us using the
        following email address: <a class="govuk-link" href="mailto:D2R2@defra.gov.uk">D2R2@defra.gov.uk</a>.
    </p>
    <p class="govuk-body">
        If you are experiencing any problems with the system, then you can contact the APHA ITU helpdesk at
        <a class="govuk-link" href="mailto:aphaservicedesk@apha.gov.uk">aphaservicedesk@apha.gov.uk</a>.
        <br /><i>N.B. This service is not provided on UK Bank Holidays.</i>
    </p>
}
else
{
    <p class="govuk-body">
        Below is the list of general reports that have been created for publication on this website. These reports have
        been generated from information held within the D2R2 Database. If the report you are seeking is not listed below
        then please contact us using the following email address:
        <a class="govuk-link" href="mailto:D2R2@defra.gov.uk">D2R2@defra.gov.uk</a>
    </p>
}

@if (Model.Reports.Count == 0)
{
    <p class="govuk-body">@(Model.IsUserManual ? "There are no user manuals to display." : "There are no reports to display.")</p>
}
else
{
    <form method="get" id="static-reports-form">
        <input type="hidden" name="UserManual" value="@Model.UserManual" />
        <input type="hidden" name="StaticReportId" value="@Model.StaticReportId" />
        <input type="hidden" id="PageNumber" name="PageNumber" value="1" />
        <div class="app-contributors-toolbar govuk-!-margin-bottom-3">
            <div class="govuk-form-group govuk-!-margin-bottom-0">
                <label class="govuk-label" for="PageSize">Items per page:</label>
                <select class="govuk-select" id="PageSize" name="PageSize" onchange="this.form.requestSubmit()">
                    @foreach (var option in CDC.Web.Pages.HelpSupport.StaticReportsModel.PageSizeOptions)
                    {
                        <option value="@option" selected="@(option == Model.PageSize ? "selected" : null)">@option</option>
                    }
                </select>
            </div>
        </div>
    </form>

    <table class="govuk-table">
        <caption class="govuk-table__caption govuk-visually-hidden">@Model.Breadcrumb.PageName</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Title</th>
                <th scope="col" class="govuk-table__header">Version</th>
                @if (!Model.IsUserManual)
                {
                    <th scope="col" class="govuk-table__header">Public?</th>
                }
                <th scope="col" class="govuk-table__header">Effective dates</th>
                @if (!Model.IsHistoryMode)
                {
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">History</span></th>
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Delete</span></th>
                }
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var report in Model.PagedReports)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">
                        <a class="govuk-link" href="@Model.GetDocumentUrl(report.Id)" target="_blank" rel="noopener noreferrer">@report.Title</a>
                    </td>
                    <td class="govuk-table__cell">@($"{report.VersionMajor}.0")</td>
                    @if (!Model.IsUserManual)
                    {
                        <td class="govuk-table__cell">@(report.IsPublic ? "Yes" : "No")</td>
                    }
                    <td class="govuk-table__cell">@CDC.Web.Pages.HelpSupport.StaticReportsModel.FormatEffectiveDates(report)</td>
                    @if (!Model.IsHistoryMode)
                    {
                        <td class="govuk-table__cell">
                            <a class="govuk-link" href="@Model.BuildHistoryUrl(report.StaticReportId)">History<span class="govuk-visually-hidden"> for @report.Title</span></a>
                        </td>
                        <td class="govuk-table__cell">
                            @if (report.CanDelete)
                            {
                                <button type="button" class="govuk-link app-link-button" data-confirm-target="#delete-static-report-@report.Id">Delete<span class="govuk-visually-hidden"> @report.Title</span></button>
                                <dialog class="app-modal" id="delete-static-report-@report.Id" aria-labelledby="delete-static-report-@(report.Id)-title">
                                    <h2 class="govuk-heading-m" id="delete-static-report-@(report.Id)-title">Confirm</h2>
                                    <p class="govuk-body">Are you sure you want to delete this @(Model.IsUserManual ? "user manual" : "report")?</p>
                                    <form method="post" asp-page-handler="Delete">
                                        <input type="hidden" name="staticReportVersionId" value="@report.Id" />
                                        <input type="hidden" name="UserManual" value="@Model.UserManual" />
                                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                        <input type="hidden" name="PageSize" value="@Model.PageSize" />
                                        <button type="submit" class="govuk-button govuk-!-margin-bottom-0 govuk-!-margin-right-2">Ok</button>
                                        <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-confirm-close>Cancel</button>
                                    </form>
                                </dialog>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <div class="app-pagination-center">
            <nav class="govuk-pagination" aria-label="Static reports pages">
                @if (Model.PageNumber > 1)
                {
                    <div class="govuk-pagination__prev">
                        <a class="govuk-link govuk-pagination__link" href="@Model.BuildPageUrl(Model.PageNumber - 1)" rel="prev">
                            <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.4443-4.1517-3.9526h12.896v-2h-12.984l4.2058-4.2058-1.3776-1.3776z"></path>
                            </svg>
                            <span class="govuk-pagination__link-title">Previous</span>
                        </a>
                    </div>
                }

                <ul class="govuk-pagination__list">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="govuk-pagination__item @(pageNumber == Model.PageNumber ? "govuk-pagination__item--current" : string.Empty)">
                            <a class="govuk-link govuk-pagination__link" href="@Model.BuildPageUrl(pageNumber)" aria-label="Page @(pageNumber)" aria-current="@(pageNumber == Model.PageNumber ? "page" : null)">@(pageNumber)</a>
                        </li>
                    }
                </ul>

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <div class="govuk-pagination__next">
                        <a class="govuk-link govuk-pagination__link" href="@Model.BuildPageUrl(Model.PageNumber + 1)" rel="next">
                            <span class="govuk-pagination__link-title">Next</span>
                            <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                                <path d="m8.107-0.0078125-1.4136 1.415 4.2926 4.2926h-12.986v2h12.896l-4.1519 4.1525 1.377 1.4445 6.7273-6.7263-6.7409-6.5938z"></path>
                            </svg>
                        </a>
                    </div>
                }
            </nav>
        </div>
    }
}

@if (!Model.IsHistoryMode && Model.CanUpload)
{
    @if (Model.ShowUploadPanel)
    {
        <div class="govuk-form-group">
            <h2 class="govuk-heading-m">Upload a @(Model.IsUserManual ? "user manual" : "static report")</h2>
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                <input type="hidden" name="UserManual" value="@Model.UserManual" />
                <div class="govuk-form-group">
                    <label class="govuk-label" for="UploadedFile">@(Model.IsUserManual ? "User manual:" : "Report file:")</label>
                    <input class="govuk-file-upload" id="UploadedFile" name="UploadedFile" type="file" accept="application/pdf" required />
                </div>
                @if (!Model.IsUserManual)
                {
                    <div class="govuk-checkboxes govuk-form-group" data-module="govuk-checkboxes">
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" id="MakePublic" name="MakePublic" type="checkbox" value="true" />
                            <label class="govuk-label govuk-checkboxes__label" for="MakePublic">Make report public (this cannot be undone)</label>
                        </div>
                    </div>
                }
                <button type="submit" class="govuk-button govuk-!-margin-bottom-0 govuk-!-margin-right-2">Ok</button>
                <a class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" asp-page="/HelpSupport/StaticReports" asp-route-UserManual="@Model.UserManual">Cancel</a>
            </form>
        </div>
    }
    else
    {
        <a class="govuk-button" asp-page="/HelpSupport/StaticReports" asp-route-UserManual="@Model.UserManual" asp-route-ShowUploadPanel="true">Add</a>
    }
}

