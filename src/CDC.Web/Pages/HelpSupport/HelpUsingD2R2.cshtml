@page
@model CDC.Web.Pages.HelpSupport.HelpUsingD2R2Model
@{
    ViewData["Title"] = "Help using D2R2";
}
@section Breadcrumbs {
    <partial name="_Breadcrumb" model="Model.Breadcrumb" />
}

<h1 class="govuk-heading-l">Help using D2R2</h1>
<p class="govuk-body">Use the documents below to find current guidance, recent updates and earlier versions of the help content available in D2R2.</p>

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Title</th>
            <th scope="col" class="govuk-table__header">Version</th>
            <th scope="col" class="govuk-table__header">Effective date</th>
            @if (Model.CanViewHistory)
            {
                <th scope="col" class="govuk-table__header">History</th>
            }
            @if (Model.CanDeleteDocuments)
            {
                <th scope="col" class="govuk-table__header">Delete</th>
            }
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var document in Model.Documents)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="@document.DownloadUrl" target="_blank" rel="noopener noreferrer" download>@document.Title</a>
                </td>
                <td class="govuk-table__cell">@document.Version</td>
                <td class="govuk-table__cell">@document.EffectiveDate</td>
                @if (Model.CanViewHistory)
                {
                    <td class="govuk-table__cell">
                        <a class="govuk-link" asp-page="/HelpSupport/DocumentHistory" asp-route-documentId="@document.DocumentId">History</a>
                    </td>
                }
                @if (Model.CanDeleteDocuments)
                {
                    <td class="govuk-table__cell">
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this user manual?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="documentId" value="@document.DocumentId" />
                            <button type="submit" class="govuk-link govuk-link--no-visited-state govuk-button govuk-button--secondary" style="padding: 0; border: none; background: none; text-align: left;">Delete</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
