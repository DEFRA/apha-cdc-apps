@page
@using CDC.Web.Infrastructure
@model CDC.Web.Pages.SpeciesData.MaintainModel
@{
    ViewData["Title"] = Model.ShowAuditTrail
        ? PaginationViewModel.TitleWithPage("Species data audit trail", Model.AuditTrailPage, Model.AuditTrailTotalPages)
        : "Maintain species data";
}
@section Breadcrumbs {
    <partial name="_Breadcrumb" model="Model.Breadcrumb" />
}

<h1 class="govuk-heading-l">@(Model.ShowAuditTrail ? "Species data audit trail" : "Maintain species data")</h1>

@if (Model.SuccessMessage is not null)
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="maintain-species-success-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="maintain-species-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.SuccessMessage</p>
        </div>
    </div>
}

@if (Model.HasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="species-error-summary-title">
        <div role="alert">
            <h2 class="govuk-error-summary__title" id="species-error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <p class="govuk-body">@Model.ErrorMessage</p>
            </div>
        </div>
    </div>
}
else if (Model.ShowAuditTrail)
{
    @if (Model.AuditTrail.Count == 0)
    {
        <p class="govuk-body">No species name or parent changes have been recorded.</p>

        <p class="govuk-body app-audit-trail-back-link">
            <a class="govuk-link" asp-page="./Maintain">Back to Maintain species data</a>
        </p>
    }
    else
    {
        <p class="govuk-body app-audit-trail-back-link">
            <a class="govuk-link" asp-page="./Maintain">Back to Maintain species data</a>
        </p>

        <div class="govuk-form-group govuk-!-margin-bottom-3 app-audit-trail-page-size">
            <label class="govuk-label govuk-!-margin-bottom-0" for="AuditTrailPageSize">Items per page:</label>
            <select class="govuk-select" id="AuditTrailPageSize" name="AuditTrailPageSize" form="audit-trail-page-size-form" onchange="this.form.requestSubmit()">
                @foreach (var option in CDC.Web.Pages.SpeciesData.MaintainModel.AuditTrailPageSizeOptions)
                {
                    <option value="@option" selected="@(option == Model.AuditTrailPageSize ? "selected" : null)">@option</option>
                }
            </select>
        </div>
        <form method="get" asp-page="./Maintain" id="audit-trail-page-size-form">
            @* A GET submit discards the action's querystring, so the handler must travel as a field. *@
            <input type="hidden" name="handler" value="AuditTrail" />
            <input type="hidden" name="AuditTrailPage" value="1" />
        </form>

        <table class="govuk-table app-audit-trail-table">
            <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">Species name/parent audit trail</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Old name</th>
                    <th scope="col" class="govuk-table__header">New name</th>
                    <th scope="col" class="govuk-table__header">User</th>
                    <th scope="col" class="govuk-table__header">Date of change</th>
                    <th scope="col" class="govuk-table__header">View details</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var entry in Model.PagedAuditTrail)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@ProfileTitleHtmlFormatter.Format(entry.OldName)</td>
                        <td class="govuk-table__cell">@ProfileTitleHtmlFormatter.Format(entry.NewName)</td>
                        <td class="govuk-table__cell">@entry.ChangedBy</td>
                        <td class="govuk-table__cell">@entry.LogDate.ToString("d MMMM yyyy HH:mm")</td>
                        <td class="govuk-table__cell">
                            <a class="govuk-link govuk-link--no-visited-state"
                               href="@Model.BuildAuditTrailDetailsUrl(entry.Id)">
                                View details<span class="govuk-visually-hidden"> of the change from @SpeciesNameHtml.ToPlainText(entry.OldName) to @SpeciesNameHtml.ToPlainText(entry.NewName)</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>


        var pagination = new PaginationViewModel
        {
            CurrentPage = Model.AuditTrailPage,
            TotalPages = Model.AuditTrailTotalPages,
            PageUrl = Model.BuildAuditTrailPageUrl,
            LandmarkLabel = "Audit trail pages"
        };
        <partial name="_Pagination" model="pagination" />

        @if (Model.AuditTrailDetailsEntry is not null)
        {
            var detailsEntry = Model.AuditTrailDetailsEntry;

            <h2 class="govuk-heading-m">Details of change to @ProfileTitleHtmlFormatter.Format(detailsEntry.NewName)</h2>

            <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--l">

            <div class="govuk-grid-row">
                <div class="govuk-grid-column-one-half">
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Old name</dt>
                            <dd class="govuk-summary-list__value">@ProfileTitleHtmlFormatter.Format(detailsEntry.OldName)</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Old parent</dt>
                            <dd class="govuk-summary-list__value">@ProfileTitleHtmlFormatter.Format(detailsEntry.OldParent)</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Changed by</dt>
                            <dd class="govuk-summary-list__value">@detailsEntry.ChangedBy</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Reason for change</dt>
                            <dd class="govuk-summary-list__value">@detailsEntry.ReasonForChange</dd>
                        </div>
                    </dl>
                </div>
                <div class="govuk-grid-column-one-half">
                    <dl class="govuk-summary-list">
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">New name</dt>
                            <dd class="govuk-summary-list__value">@ProfileTitleHtmlFormatter.Format(detailsEntry.NewName)</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">New parent</dt>
                            <dd class="govuk-summary-list__value">@ProfileTitleHtmlFormatter.Format(detailsEntry.NewParent)</dd>
                        </div>
                        <div class="govuk-summary-list__row">
                            <dt class="govuk-summary-list__key">Date of change</dt>
                            <dd class="govuk-summary-list__value">@detailsEntry.LogDate.ToString("d MMMM yyyy HH:mm")</dd>
                        </div>
                    </dl>
                </div>
            </div>
        }
    }
}
else if (Model.SpeciesTree.Nodes.Count == 0)
{
    <p class="govuk-body">No active species data is available.</p>
}
else
{
    <form method="post">
        <div class="govuk-form-group app-tree__form-group">
            <fieldset class="govuk-fieldset" aria-describedby="@(Model.ReorderMode ? null : "species-tree-status")">
                <legend class="govuk-visually-hidden">Species and species groups</legend>

                <div class="app-species-layout">
                    <div class="app-tree__column">
                        <div class="app-tree__panel">
                            <div class="app-tree__controls">
                                <button type="button" class="app-tree__toggle-all" data-app-tree-action="toggle-all" aria-expanded="false">
                                    <span class="app-tree__toggle-all-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 8" fill="none" stroke="currentColor"
                                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                                            <path d="M1 1l5 5 5-5" />
                                        </svg>
                                    </span>
                                    <span class="app-tree__toggle-all-text">Open all</span>
                                </button>
                            </div>
                            <partial name="_TreeView" model="Model.SpeciesTree" />
                        </div>
                        @if (!Model.ReorderMode)
                        {
                            <output class="govuk-body app-tree__status" id="species-tree-status" hidden></output>
                        }
                        else
                        {
                            <div class="app-tree__actions">
                                <button type="submit" asp-page-handler="ReorderDone" formnovalidate class="govuk-button" data-module="govuk-button">
                                    Done
                                </button>
                            </div>
                        }
                    </div>

                    @if (!Model.ReorderMode)
                    {
                        <div class="app-species-actions">
                            @* A GET submit button loses its formaction query string (the browser replaces it
                               with the serialised form fields), so this is a plain link instead. It has a real
                               href and behaves like ordinary navigation, so no button role or JS is needed. *@
                            <a asp-page="./Maintain" asp-page-handler="AuditTrail"
                                class="govuk-button" data-module="govuk-button">
                                View audit trail
                            </a>
                            <button type="submit" asp-page-handler="Add" formnovalidate class="govuk-button" data-module="govuk-button">
                                Add
                            </button>
                            <button type="submit" asp-page-handler="EditNameParent" class="govuk-button" data-module="govuk-button">
                                Edit name/parent
                            </button>
                            <button type="submit" asp-page-handler="EditData" formnovalidate class="govuk-button" data-module="govuk-button">
                                Edit data
                            </button>
                            <button type="submit" asp-page-handler="Delete" formnovalidate class="govuk-button govuk-button--warning" data-module="govuk-button">
                                Delete
                            </button>
                            <button type="submit" asp-page-handler="Inactivate" formnovalidate class="govuk-button" data-module="govuk-button">
                                Inactivate
                            </button>
                            <button type="submit" asp-page-handler="ReorderList" formnovalidate class="govuk-button" data-module="govuk-button">
                                Reorder list
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="app-species-actions" data-app-reorder-controls>
                            <button type="submit" id="reorder-move-up" asp-page-handler="MoveUp" formnovalidate
                                disabled="@(!Model.CanMoveSelectedUp ? "disabled" : null)"
                                title="Move the selected species up"
                                class="govuk-button govuk-button--secondary app-reorder-arrow" data-module="govuk-button">
                                <span aria-hidden="true">&uarr;</span>
                                <span class="govuk-visually-hidden">Move up</span>
                            </button>
                            <button type="submit" id="reorder-move-down" asp-page-handler="MoveDown" formnovalidate
                                disabled="@(!Model.CanMoveSelectedDown ? "disabled" : null)"
                                title="Move the selected species down"
                                class="govuk-button govuk-button--secondary app-reorder-arrow" data-module="govuk-button">
                                <span aria-hidden="true">&darr;</span>
                                <span class="govuk-visually-hidden">Move down</span>
                            </button>
                        </div>
                    }
                </div>

                @if (!Model.ReorderMode)
                {
                    <div class="app-tree__actions">
                        <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-app-tree-action="clear">
                            Remove selection
                        </button>
                    </div>
                }
            </fieldset>
        </div>

        @if (Model.SelectionErrorMessage is not null)
        {
            <p class="govuk-error-message" id="species-select-error">
                <span class="govuk-visually-hidden">Error:</span> @Model.SelectionErrorMessage
            </p>
        }

    </form>
}


@if (Model.ShowAddPanel)
{
    var newEntry = CDC.Web.Pages.SpeciesData.MaintainModel.NewEntryPlaceholder;
    var rootSpeciesLabel = CDC.Web.Pages.SpeciesData.MaintainModel.RootSpeciesLabel;

    <div class="govuk-!-margin-top-6" id="add-species-panel">
        <h2 class="govuk-heading-m">Add species data value</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="add-error-summary-title">
                <div role="alert">
                    <h2 class="govuk-error-summary__title" id="add-error-summary-title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            @foreach (var (key, message) in ViewData.ModelState.SelectMany(entry => entry.Value!.Errors.Select(error => (entry.Key, error.ErrorMessage))))
                            {
                                @if (key.Length == 0)
                                {
                                    <li>@message</li>
                                }
                                else
                                {
                                    <li><a href="#@(key.Replace('.', '_'))">@message</a></li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <form method="post">
            <div class="app-legacy-form">
                <span class="app-legacy-form__label app-legacy-form__cell--bottom">Old name:</span>
                <div class="govuk-input app-legacy-form__value app-legacy-form__cell--bottom" id="add-old-name" aria-label="Old name">@newEntry</div>

                <label class="app-legacy-form__label app-legacy-form__cell--bottom" asp-for="AddInput.Name">New name:</label>
                <div class="app-legacy-form__field@(ViewData.ModelState["AddInput.Name"]?.Errors.Count > 0 ? " govuk-form-group--error" : "")">
                    <span class="govuk-error-message" asp-validation-for="AddInput.Name"></span>
                    <input class="govuk-input" asp-for="AddInput.Name" maxlength="50" autocomplete="off" data-single-line-richtext />
                </div>

                <span class="app-legacy-form__label">Old parent:</span>
                <div class="govuk-input app-legacy-form__value" id="add-old-parent" aria-label="Old parent">@newEntry</div>

                <label class="app-legacy-form__label" asp-for="AddInput.ParentId">New parent:</label>
                <div class="app-legacy-form__field@(ViewData.ModelState["AddInput.ParentId"]?.Errors.Count > 0 ? " govuk-form-group--error" : "")">
                    <span class="govuk-error-message" asp-validation-for="AddInput.ParentId"></span>
                    <select class="govuk-select" asp-for="AddInput.ParentId">
                        <option value="">Please select</option>
                        <option value="@Guid.Empty">@rootSpeciesLabel</option>
                        @foreach (var parentChoice in Model.ParentChoices)
                        {
                            <option value="@parentChoice.Id">@SpeciesNameHtml.ToPlainText(parentChoice.Name)</option>
                        }
                    </select>
                </div>

                <label class="app-legacy-form__label" asp-for="AddInput.Reason">Reason for change:</label>
                <div class="app-legacy-form__field app-legacy-form__field--wide@(ViewData.ModelState["AddInput.Reason"]?.Errors.Count > 0 ? " govuk-form-group--error" : "")">
                    <span class="govuk-error-message" asp-validation-for="AddInput.Reason"></span>
                    <textarea class="govuk-textarea" asp-for="AddInput.Reason" rows="1" maxlength="255"></textarea>
                </div>

                <div class="app-legacy-form__actions">
                    <button type="submit" asp-page-handler="SaveNew" class="govuk-button" data-module="govuk-button">Save</button>
                    <button type="submit" asp-page-handler="CancelAdd" formnovalidate class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</button>
                </div>
            </div>
        </form>
    </div>
}

@if (Model.ShowEditPanel && Model.SpeciesDetail is not null)
{
    <div class="govuk-!-margin-top-6" id="edit-name-parent-panel">
        <h2 class="govuk-heading-m">Edit species data value</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="edit-error-summary-title">
                <div role="alert">
                    <h2 class="govuk-error-summary__title" id="edit-error-summary-title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            @foreach (var (key, message) in ViewData.ModelState.SelectMany(entry => entry.Value!.Errors.Select(error => (entry.Key, error.ErrorMessage))))
                            {
                                @if (key.Length == 0)
                                {
                                    <li>@message</li>
                                }
                                else
                                {
                                    <li><a href="#@(key.Replace('.', '_'))">@message</a></li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="Input.SpeciesId" />
            <input type="hidden" asp-for="Input.LastUpdatedBase64" />

            <div class="app-legacy-form">
                <span class="app-legacy-form__label app-legacy-form__cell--bottom">Old name:</span>
                <div class="govuk-input app-legacy-form__value app-legacy-form__cell--bottom" id="old-name" aria-label="Old name">@ProfileTitleHtmlFormatter.Format(Model.SpeciesDetail.Name)</div>

                <label class="app-legacy-form__label app-legacy-form__cell--bottom" asp-for="Input.Name">New name:</label>
                <div class="app-legacy-form__field@(ViewData.ModelState["Input.Name"]?.Errors.Count > 0 ? " govuk-form-group--error" : "")">
                    <span class="govuk-error-message" asp-validation-for="Input.Name"></span>
                    <input class="govuk-input" asp-for="Input.Name" maxlength="50" autocomplete="off" data-single-line-richtext />
                </div>

                <span class="app-legacy-form__label">Old parent:</span>
                <div class="govuk-input app-legacy-form__value" id="old-parent" aria-label="Old parent">@ProfileTitleHtmlFormatter.Format(string.IsNullOrEmpty(Model.SpeciesDetail.ParentName) ? "- root species -" : Model.SpeciesDetail.ParentName)</div>

                <label class="app-legacy-form__label" asp-for="Input.ParentId">New parent:</label>
                <div class="app-legacy-form__field@(ViewData.ModelState["Input.ParentId"]?.Errors.Count > 0 ? " govuk-form-group--error" : "")">
                    <span class="govuk-error-message" asp-validation-for="Input.ParentId"></span>
                    <select class="govuk-select" asp-for="Input.ParentId">
                        <option value="">- root species -</option>
                        @foreach (var validParent in Model.ValidParents)
                        {
                            <option value="@validParent.Id">@SpeciesNameHtml.ToPlainText(validParent.Name)</option>
                        }
                    </select>
                </div>

                <label class="app-legacy-form__label" asp-for="Input.Reason">Reason for change:</label>
                <div class="app-legacy-form__field app-legacy-form__field--wide@(ViewData.ModelState["Input.Reason"]?.Errors.Count > 0 ? " govuk-form-group--error" : "")">
                    <span class="govuk-error-message" asp-validation-for="Input.Reason"></span>
                    <textarea class="govuk-textarea" asp-for="Input.Reason" rows="1" maxlength="255"></textarea>
                </div>

                <div class="app-legacy-form__actions">
                    <button type="submit" asp-page-handler="Save" class="govuk-button" data-module="govuk-button">Save</button>
                    <button type="submit" asp-page-handler="Cancel" formnovalidate class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</button>
                </div>
            </div>
        </form>
    </div>
}

@if (Model.ShowInactivatePanel && Model.SpeciesDetail is not null)
{
    <div class="govuk-!-margin-top-6" id="inactivate-panel">
        <h2 class="govuk-heading-m">Inactivate species data value</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="inactivate-error-summary-title">
                <div role="alert">
                    <h2 class="govuk-error-summary__title" id="inactivate-error-summary-title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            @foreach (var (key, message) in ViewData.ModelState.SelectMany(entry => entry.Value!.Errors.Select(error => (entry.Key, error.ErrorMessage))))
                            {
                                @if (key.Length == 0)
                                {
                                    <li>@message</li>
                                }
                                else
                                {
                                    <li><a href="#@(key.Replace('.', '_'))">@message</a></li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="InactivateInput.SpeciesId" />
            <input type="hidden" asp-for="InactivateInput.LastUpdatedBase64" />

            <div class="govuk-form-group">
                <span class="govuk-label govuk-!-font-weight-bold">Old name</span>
                <p class="govuk-body" id="inactivate-old-name">@ProfileTitleHtmlFormatter.Format(Model.SpeciesDetail.Name)</p>
            </div>

            <div class="govuk-form-group">
                <span class="govuk-label govuk-!-font-weight-bold">Old parent</span>
                <p class="govuk-body" id="inactivate-old-parent">
                    @ProfileTitleHtmlFormatter.Format(string.IsNullOrEmpty(Model.SpeciesDetail.ParentName) ? "- root species -" : Model.SpeciesDetail.ParentName)
                </p>
            </div>

            <div class="govuk-form-group@(ViewData.ModelState["InactivateInput.Reason"]?.Errors.Count > 0 ? " govuk-form-group--error" : "")">
                <label class="govuk-label" asp-for="InactivateInput.Reason">Reason for change</label>
                <div class="govuk-hint">Explain why this species is being inactivated. Required.</div>
                <span class="govuk-error-message" asp-validation-for="InactivateInput.Reason"></span>
                <textarea class="govuk-textarea" asp-for="InactivateInput.Reason" rows="4" maxlength="255"></textarea>
            </div>

            <div class="govuk-button-group">
                <button type="submit" asp-page-handler="ConfirmInactivate" class="govuk-button" data-module="govuk-button">Inactivate</button>
                <button type="submit" asp-page-handler="CancelInactivate" formnovalidate class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</button>
            </div>
        </form>
    </div>
}

@if (Model.ShowDeletePanel && Model.SpeciesDetail is not null)
{
    <div class="govuk-!-margin-top-6" id="delete-panel">
        <h2 class="govuk-heading-m">Delete species data value</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary" tabindex="-1" aria-labelledby="delete-error-summary-title">
                <div role="alert">
                    <h2 class="govuk-error-summary__title" id="delete-error-summary-title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            @foreach (var (key, message) in ViewData.ModelState.SelectMany(entry => entry.Value!.Errors.Select(error => (entry.Key, error.ErrorMessage))))
                            {
                                @if (key.Length == 0)
                                {
                                    <li>@message</li>
                                }
                                else
                                {
                                    <li><a href="#@(key.Replace('.', '_'))">@message</a></li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="DeleteInput.SpeciesId" />
            <input type="hidden" asp-for="DeleteInput.LastUpdatedBase64" />

            <div class="app-legacy-form">
                <span class="app-legacy-form__label">Old name:</span>
                <div class="govuk-input app-legacy-form__value" id="delete-old-name" aria-label="Old name">@ProfileTitleHtmlFormatter.Format(Model.SpeciesDetail.Name)</div>

                <label class="app-legacy-form__label" for="delete-new-name">New name:</label>
                <div class="app-legacy-form__field">
                    <input class="govuk-input" id="delete-new-name" type="text" value="- to be deleted -" disabled />
                </div>

                <span class="app-legacy-form__label">Old parent:</span>
                <div class="govuk-input app-legacy-form__value" id="delete-old-parent" aria-label="Old parent">@ProfileTitleHtmlFormatter.Format(string.IsNullOrEmpty(Model.SpeciesDetail.ParentName) ? "- root species -" : Model.SpeciesDetail.ParentName)</div>

                <label class="app-legacy-form__label" for="delete-new-parent">New parent:</label>
                <div class="app-legacy-form__field">
                    <select class="govuk-select" id="delete-new-parent" disabled>
                        <option>Please select</option>
                    </select>
                </div>

                <label class="app-legacy-form__label" asp-for="DeleteInput.Reason">Reason for change:</label>
                <div class="app-legacy-form__field app-legacy-form__field--wide@(ViewData.ModelState["DeleteInput.Reason"]?.Errors.Count > 0 ? " govuk-form-group--error" : "")">
                    <span class="govuk-error-message" asp-validation-for="DeleteInput.Reason"></span>
                    <textarea class="govuk-textarea" asp-for="DeleteInput.Reason" rows="1" maxlength="255"></textarea>
                </div>

                <div class="app-legacy-form__actions">
                    <button type="submit" asp-page-handler="ConfirmDelete" class="govuk-button" data-module="govuk-button">Delete</button>
                    <button type="submit" asp-page-handler="CancelDelete" formnovalidate class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</button>
                </div>
            </div>
        </form>
    </div>
}

@section Scripts {
    <script src="~/js/tree-view.js" asp-append-version="true"></script>
    <script src="~/js/reorder-controls.js" asp-append-version="true"></script>
    <script src="~/js/single-line-richtext.js" asp-append-version="true"></script>
}
