@page
@model CDC.Web.Pages.CrossProfileAdmin.ReferenceDataAuditDetailsModel
@{
    ViewData["Title"] = "Reference data change details";
}
@section Breadcrumbs {
    <a class="govuk-back-link" asp-page="/CrossProfileAdmin/ReferenceDataAudit" asp-route-tableId="@Model.Entry?.ReferenceTableId">Back to audit trail</a>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">@Model.Entry?.TableName</span>
        <h1 class="govuk-heading-l">Reference data change details</h1>

        <dl class="govuk-summary-list">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Old value</dt>
                <dd class="govuk-summary-list__value">@CDC.Web.Infrastructure.ProfileTitleHtmlFormatter.Format(Model.Entry?.OldLookupValue)</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">New value</dt>
                <dd class="govuk-summary-list__value">@CDC.Web.Infrastructure.ProfileTitleHtmlFormatter.Format(Model.Entry?.NewLookupValue)</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Changed by</dt>
                <dd class="govuk-summary-list__value">@Model.Entry?.UserFullName</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Date of change</dt>
                <dd class="govuk-summary-list__value">@Model.Entry?.LogDate.ToString("d MMMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Reason for change</dt>
                <dd class="govuk-summary-list__value">@CDC.Web.Infrastructure.Reports.ReportRichText.ToHtml(Model.Entry?.Reason)</dd>
            </div>
        </dl>

        <p class="govuk-body">
            <a class="govuk-link" asp-page="/CrossProfileAdmin/ReferenceData" asp-route-tableId="@Model.Entry?.ReferenceTableId">Maintain reference data</a>
        </p>
    </div>
</div>
