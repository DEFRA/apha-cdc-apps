@page
@model CDC.Web.Pages.CrossProfileAdmin.PrioritisationVariablesModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using CDC.Web.Pages.CrossProfileAdmin
@{
    var hasErrors = !ViewData.ModelState.IsValid;
    ViewData["Title"] = (hasErrors ? "Error: " : string.Empty) + "Maintain profile prioritisation variables";

    string? ErrorFor(string key) =>
        ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;

    string? AnchorFor(string key) => key switch
    {
        nameof(Model.LowerBound) => "#lower-bound",
        nameof(Model.UpperBound) => "#upper-bound",
        nameof(Model.CriterionWeight) => "#criterion-weight",
        PrioritisationVariablesModel.DraftPrioritisationErrorKey => "#run-draft-prioritisation",
        PrioritisationVariablesModel.ExportErrorKey => "#export-normalised-scores",
        _ when key.StartsWith(nameof(Model.CriterionValueScores) + "[", StringComparison.Ordinal) =>
            "#criterion-value-score-" + key[(nameof(Model.CriterionValueScores).Length + 1)..key.IndexOf(']', StringComparison.Ordinal)],
        _ => null
    };

    var lowerBoundError = ErrorFor(nameof(Model.LowerBound));
    var upperBoundError = ErrorFor(nameof(Model.UpperBound));
    var criterionWeightError = ErrorFor(nameof(Model.CriterionWeight));
    var draftError = ErrorFor(PrioritisationVariablesModel.DraftPrioritisationErrorKey);
}
@section Breadcrumbs {
    <partial name="_Breadcrumb" model="Model.Breadcrumb" />
}

@if (hasErrors)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var entry in ViewData.ModelState)
                    {
                        var anchor = AnchorFor(entry.Key);
                        foreach (var error in entry.Value.Errors)
                        {
                            <li>
                                @if (anchor is not null)
                                {
                                    <a href="@anchor">@error.ErrorMessage</a>
                                }
                                else
                                {
                                    @error.ErrorMessage
                                }
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
}

<h1 class="govuk-heading-l">Maintain profile prioritisation variables</h1>

<p class="govuk-body">
    Use this function to maintain the weightings and scores associated with prioritisation
    criteria. Please note, if you make and confirm changes to this information, this
    will trigger an automatic re-calculation of all prioritisation scores of published
    profiles. Do not use this function for the purpose of developing ‘what-if’ scenarios;
    a separate spreadsheet exists, outside of this application, which has been developed
    for this purpose.
</p>

<h2 class="govuk-heading-m">Draft prioritisation</h2>
<form method="post" asp-page-handler="RunDraftPrioritisation" novalidate>
    <input type="hidden" asp-for="SelectedCategoryId" id="draft-selected-category-id" />
    <input type="hidden" asp-for="SelectedCriterionId" id="draft-selected-criterion-id" />
    <div class="govuk-form-group @(draftError is null ? string.Empty : "govuk-form-group--error")">
        @if (draftError is not null)
        {
            <p class="govuk-error-message" id="run-draft-prioritisation-error">
                <span class="govuk-visually-hidden">Error:</span> @draftError
            </p>
        }
        <div class="app-label-select-inline">
            <span class="govuk-label" id="run-draft-prioritisation-hint">Calculate prioritisation scores for draft profiles</span>
            <button type="submit" id="run-draft-prioritisation" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button" data-prevent-double-click="true"
                    aria-describedby="run-draft-prioritisation-hint@(draftError is null ? string.Empty : " run-draft-prioritisation-error")">Go</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <p class="govuk-body govuk-!-margin-top-2 govuk-!-margin-bottom-0" role="status">@Model.SuccessMessage</p>
        }
    </div>
</form>

<div class="govuk-button-group app-button-group--right govuk-!-margin-bottom-0">
    <button type="button" id="update-prioritisation-variables" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-confirm-target="#confirm-update-dialog">Update</button>
</div>
@if (!string.IsNullOrWhiteSpace(Model.UpdateResultMessage))
{
    <p class="govuk-body app-text-align-right" role="status">@Model.UpdateResultMessage</p>
}

<form method="post" id="prioritisation-variables-form" novalidate>
    <input type="hidden" asp-for="RowVersion" />

    <div class="govuk-form-group @(lowerBoundError is null && upperBoundError is null ? string.Empty : "govuk-form-group--error")">
        <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                <h2 class="govuk-fieldset__heading">Edit ranking range</h2>
            </legend>
            @if (lowerBoundError is not null)
            {
                <p class="govuk-error-message" id="lower-bound-error"><span class="govuk-visually-hidden">Error:</span> @lowerBoundError</p>
            }
            @if (upperBoundError is not null)
            {
                <p class="govuk-error-message" id="upper-bound-error"><span class="govuk-visually-hidden">Error:</span> @upperBoundError</p>
            }
            <div class="app-select-with-actions">
                <div class="app-label-select-inline">
                    <label class="govuk-label" for="lower-bound">Lower bound</label>
                    <input asp-for="LowerBound" type="text" maxlength="3" class="govuk-input govuk-input--width-3 @(lowerBoundError is null ? string.Empty : "govuk-input--error")" id="lower-bound" inputmode="numeric" spellcheck="false"
                           aria-describedby="@(lowerBoundError is null ? null : "lower-bound-error")" />
                </div>
                <div class="app-label-select-inline">
                    <label class="govuk-label" for="upper-bound">Upper bound</label>
                    <input asp-for="UpperBound" type="text" maxlength="3" class="govuk-input govuk-input--width-3 @(upperBoundError is null ? string.Empty : "govuk-input--error")" id="upper-bound" inputmode="numeric" spellcheck="false"
                           aria-describedby="@(upperBoundError is null ? null : "upper-bound-error")" />
                </div>
            </div>
        </fieldset>
    </div>

    @if (Model.SelectedCategoryId is not null)
    {
        <input type="hidden" asp-for="SelectedCategoryId" id="update-selected-category-id" />
    }
    @if (Model.SelectedCriterion is not null)
    {
        <input type="hidden" asp-for="SelectedCriterionId" id="update-selected-criterion-id" />
    }
</form>

@if (!string.IsNullOrWhiteSpace(Model.CategoriesErrorMessage))
{
    <p class="govuk-body">@Model.CategoriesErrorMessage</p>
}

@* Loads the category as soon as it is chosen, as the legacy AutoPostBack dropdown did; the button is only a no-JavaScript fallback. *@
<form method="get" novalidate class="govuk-!-margin-top-6" data-submit-on-change>
    <div class="govuk-form-group app-select-with-actions">
        <div class="app-label-select-inline">
            <label class="govuk-label" for="prioritisation-category">Prioritisation category</label>
            <select class="govuk-select" id="prioritisation-category" asp-for="SelectedCategoryId" asp-items="@(new SelectListItem[] { new("Please select...", "") }.Concat(Model.Categories.Select(category => new SelectListItem(category.Name, category.Id.ToString()))))"></select>
        </div>
        <noscript>
            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Select</button>
        </noscript>
        @if (Model.SelectedCategoryId is { } exportCategoryId)
        {
            <a asp-page="PrintPrioritisationVariables" asp-route-categoryId="@exportCategoryId" role="button" draggable="false" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" target="_blank" rel="noopener noreferrer">
                Print category variables<span class="govuk-visually-hidden"> (opens in new tab)</span>
            </a>
            <a asp-page-handler="ExportScoreData" asp-route-SelectedCategoryId="@exportCategoryId" role="button" draggable="false" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" id="export-score-data">Export score data</a>
        }
        else
        {
            <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" disabled aria-disabled="true">Print category variables</button>
            <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" disabled aria-disabled="true">Export score data</button>
        }
        <a asp-page-handler="ExportNormalisedScores" role="button" draggable="false" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" id="export-normalised-scores">Export normalised scores (all categories)</a>
    </div>
</form>

@if (Model.SelectedCategoryId is not null)
{
    @if (Model.SelectedCategoryCriteria.Count == 0)
    {
        <p class="govuk-body">No criteria are recorded against this category.</p>
    }
    else
    {
        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-visually-hidden">Criteria for the selected prioritisation category</caption>
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Criterion</span></th>
                    <th scope="col" class="govuk-table__header">Weighting</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var criterion in Model.SelectedCategoryCriteria)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            <a class="govuk-link" href="?SelectedCategoryId=@Model.SelectedCategoryId&SelectedCriterionId=@criterion.Id">@criterion.Code - @criterion.Name</a>
                        </td>
                        <td class="govuk-table__cell">@criterion.Weight</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.SelectedCriterion is { } selectedCriterion)
    {
        <h2 class="govuk-heading-m govuk-!-margin-top-7">@selectedCriterion.Code</h2>
        <div class="govuk-form-group app-label-select-inline">
            <span class="govuk-label">Criterion name</span>
            <span class="govuk-body govuk-!-margin-bottom-0">@selectedCriterion.Name</span>
        </div>
        <div class="govuk-form-group @(criterionWeightError is null ? string.Empty : "govuk-form-group--error")">
            @if (criterionWeightError is not null)
            {
                <p class="govuk-error-message" id="criterion-weight-error"><span class="govuk-visually-hidden">Error:</span> @criterionWeightError</p>
            }
            <div class="app-label-select-inline">
                <label class="govuk-label" for="criterion-weight">Weighting</label>
                <input asp-for="CriterionWeight" form="prioritisation-variables-form" type="text" maxlength="3" class="govuk-input govuk-input--width-3 @(criterionWeightError is null ? string.Empty : "govuk-input--error")" id="criterion-weight" inputmode="numeric" spellcheck="false"
                       aria-describedby="@(criterionWeightError is null ? null : "criterion-weight-error")" />
            </div>
        </div>

        @if (selectedCriterion.Values.Count > 0)
        {
                    <table class="govuk-table">
                        <caption class="govuk-table__caption govuk-visually-hidden">Scores for @selectedCriterion.Code</caption>
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Value</th>
                                <th scope="col" class="govuk-table__header">Score</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @for (var i = 0; i < selectedCriterion.Values.Count; i++)
                            {
                                var value = selectedCriterion.Values[i];
                                var currentScore = Model.CriterionValueScores.FirstOrDefault(v => v.Id == value.Id)?.Score ?? value.Score;
                                var scoreError = ErrorFor($"{nameof(Model.CriterionValueScores)}[{i}].Score");
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">
                                        <label class="govuk-label govuk-!-margin-bottom-0" for="criterion-value-score-@i">@value.Value</label>
                                    </td>
                                    <td class="govuk-table__cell">
                                        <div class="govuk-form-group govuk-!-margin-bottom-0 @(scoreError is null ? string.Empty : "govuk-form-group--error")">
                                            @if (scoreError is not null)
                                            {
                                                <p class="govuk-error-message" id="criterion-value-score-@i-error"><span class="govuk-visually-hidden">Error:</span> @scoreError</p>
                                            }
                                            <input type="hidden" form="prioritisation-variables-form" name="CriterionValueScores[@i].Id" value="@value.Id" />
                                            <input type="text" form="prioritisation-variables-form" name="CriterionValueScores[@i].Score" id="criterion-value-score-@i" value="@currentScore" class="govuk-input govuk-input--width-3 @(scoreError is null ? string.Empty : "govuk-input--error")" inputmode="numeric" spellcheck="false"
                                                   aria-describedby="@(scoreError is null ? null : $"criterion-value-score-{i}-error")" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
        }
    }
}

<dialog class="app-modal" id="confirm-update-dialog" aria-labelledby="confirm-update-dialog-title" aria-describedby="confirm-update-dialog-message">
    <h2 class="govuk-heading-m" id="confirm-update-dialog-title">Confirm</h2>
    <p class="govuk-body" id="confirm-update-dialog-message">Are you sure you want to update the global prioritisation variables?</p>
    <div class="govuk-button-group govuk-!-margin-bottom-0">
        <button type="submit" form="prioritisation-variables-form" asp-page-handler="Update" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button" data-prevent-double-click="true">OK</button>
        <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" data-confirm-close>Cancel</button>
    </div>
</dialog>

@section Scripts {
    <script>
        document.querySelectorAll('form[data-submit-on-change] select').forEach(function (select) {
            select.addEventListener('change', function () { select.form.submit(); });
        });
    </script>
}
