@page
@model CDC.Web.Pages.CrossProfileAdmin.PrintPrioritisationVariablesModel
@{
    ViewData["Title"] = Model.Category is null ? "Print category variables" : $"{Model.Category.Name} category variables";
}
@section Breadcrumbs {
    <div class="govuk-!-display-none-print">
        <partial name="_Breadcrumb" model="Model.Breadcrumb" />
    </div>
}

@if (Model.Category is null)
{
    <h1 class="govuk-heading-l">Print category variables</h1>
    <p class="govuk-body">@Model.ErrorMessage</p>
}
else
{
    <span class="govuk-caption-l">Prioritisation category</span>
    <h1 class="govuk-heading-l">@Model.Category.Name</h1>

    <button type="button" class="govuk-button govuk-button--secondary govuk-!-display-none-print" data-module="govuk-button" data-print-page hidden>Print this page</button>

    @if (Model.Category.Criteria.Count == 0)
    {
        <p class="govuk-body">No criteria are recorded against this category.</p>
    }

    @foreach (var criterion in Model.Category.Criteria)
    {
        <h2 class="govuk-heading-m govuk-!-margin-top-6">@criterion.Code - @criterion.Name</h2>
        <p class="govuk-body">Weighting: <strong>@criterion.Weight</strong></p>
        @if (criterion.Values.Count > 0)
        {
            <table class="govuk-table">
                <caption class="govuk-table__caption govuk-visually-hidden">Scores for @criterion.Code - @criterion.Name</caption>
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Value</th>
                        <th scope="col" class="govuk-table__header govuk-table__header--numeric">Score</th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @foreach (var value in criterion.Values)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@value.Value</td>
                            <td class="govuk-table__cell govuk-table__cell--numeric">@value.Score</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@section Scripts {
    <script>
        document.querySelectorAll('[data-print-page]').forEach(function (button) {
            button.hidden = false;
            button.addEventListener('click', function () { window.print(); });
        });
    </script>
}
