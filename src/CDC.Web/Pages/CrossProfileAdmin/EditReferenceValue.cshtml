@page
@model CDC.Web.Pages.CrossProfileAdmin.EditReferenceValueModel
@{
    var hasErrors = !ViewData.ModelState.IsValid;
    ViewData["Title"] = hasErrors ? "Error: Change a reference value" : "Change a reference value";

    var newValueError = Model.ErrorFor(nameof(Model.NewLookupValue));
    var reasonError = Model.ErrorFor(nameof(Model.Reason));
}
@section Breadcrumbs {
    <a class="govuk-back-link" asp-page="/CrossProfileAdmin/ReferenceData" asp-route-tableId="@Model.TableId">Back to @(Model.Table?.Name ?? "reference data")</a>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @if (hasErrors)
        {
            <div class="govuk-error-summary" data-module="govuk-error-summary">
                <div role="alert">
                    <h2 class="govuk-error-summary__title">There is a problem</h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            @if (newValueError is not null)
                            {
                                <li><a href="#NewLookupValue">@newValueError</a></li>
                            }
                            @if (reasonError is not null)
                            {
                                <li><a href="#Reason">@reasonError</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <span class="govuk-caption-l">@Model.Table?.Name</span>
        <h1 class="govuk-heading-l">Change a reference value</h1>

        <dl class="govuk-summary-list govuk-summary-list--no-border">
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Old value</dt>
                <dd class="govuk-summary-list__value">@Model.ExistingValue?.LookupValue</dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Effective date</dt>
                <dd class="govuk-summary-list__value">
                    @(Model.ExistingValue?.EffectiveDateFrom?.ToString("d MMMM yyyy") ?? "Not recorded")
                </dd>
            </div>
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Status</dt>
                <dd class="govuk-summary-list__value">@Model.ExistingValue?.Status</dd>
            </div>
        </dl>

        <form method="post">
            <input type="hidden" name="tableId" value="@Model.TableId" />
            <input type="hidden" name="valueId" value="@Model.ValueId" />

            <div class="govuk-form-group @(newValueError is not null ? "govuk-form-group--error" : string.Empty)">
                <label class="govuk-label" for="NewLookupValue">New value</label>
                @if (newValueError is not null)
                {
                    <p id="NewLookupValue-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span> @newValueError
                    </p>
                }
                <input class="govuk-input @(newValueError is not null ? "govuk-input--error" : string.Empty)"
                       id="NewLookupValue" name="NewLookupValue" type="text" spellcheck="false"
                       maxlength="@CDC.Web.Pages.CrossProfileAdmin.EditReferenceValueModel.ValueMaxLength"
                       value="@Model.NewLookupValue"
                       aria-describedby="@(newValueError is not null ? "NewLookupValue-error" : null)" />
            </div>

            <div class="govuk-form-group @(reasonError is not null ? "govuk-form-group--error" : string.Empty)">
                <label class="govuk-label" for="Reason">Reason for change</label>
                <div id="Reason-hint" class="govuk-hint">This is recorded in the audit trail. You cannot save without it.</div>
                @if (reasonError is not null)
                {
                    <p id="Reason-error" class="govuk-error-message">
                        <span class="govuk-visually-hidden">Error:</span> @reasonError
                    </p>
                }
                <textarea class="govuk-textarea @(reasonError is not null ? "govuk-textarea--error" : string.Empty)"
                          id="Reason" name="Reason" rows="4"
                          maxlength="@CDC.Web.Pages.CrossProfileAdmin.EditReferenceValueModel.ReasonMaxLength"
                          aria-describedby="Reason-hint@(reasonError is not null ? " Reason-error" : null)">@Model.Reason</textarea>
            </div>

            <div class="govuk-button-group">
                <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
                <a class="govuk-link govuk-link--no-visited-state" asp-page="/CrossProfileAdmin/ReferenceData" asp-route-tableId="@Model.TableId">Cancel</a>
            </div>
        </form>
    </div>
</div>
