@model CDC.Web.Pages.CrossProfileAdmin.PrioritisationVariablesModel
@* Also returned alone by the CriterionPanel handler. OK holds the edits as pending changes for Update to save; Cancel discards them. *@
@{
    var criterion = Model.SelectedCriterion!;
}

<div id="criterion-panel-content" data-criterion-id="@criterion.Id" data-criterion-code="@criterion.Code">
<h2 class="govuk-heading-m govuk-!-margin-top-7" id="criterion-panel-heading" tabindex="-1">@criterion.Code</h2>

<div class="govuk-error-summary" data-criterion-errors hidden tabindex="-1">
    <div role="alert">
        <h2 class="govuk-error-summary__title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list" data-criterion-error-list></ul>
        </div>
    </div>
</div>

@* Labels in a column to the left of their inputs, as the legacy criterion panel's two-row table laid them out. *@
<div class="app-criterion-edit govuk-!-margin-bottom-6">
    <label class="govuk-label app-criterion-edit__label app-criterion-edit__label--editor" for="criterion-name">Criterion name:</label>
    <div class="app-criterion-edit__field">
        <input id="criterion-name" value="@Model.CriterionName" type="text" maxlength="255" autocomplete="off" class="govuk-input" data-single-line-richtext />
    </div>

    <label class="govuk-label app-criterion-edit__label" for="criterion-weight">Weighting:</label>
    <div class="app-criterion-edit__field">
        <input id="criterion-weight" value="@Model.CriterionWeight" type="text" maxlength="3" inputmode="numeric" spellcheck="false" class="govuk-input govuk-input--width-3" />
    </div>
</div>

@if (criterion.Values.Count > 0)
{
    <table class="govuk-table">
        <caption class="govuk-table__caption govuk-visually-hidden">Scores for @criterion.Code</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Value</th>
                <th scope="col" class="govuk-table__header">Score</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @for (var i = 0; i < criterion.Values.Count; i++)
            {
                var value = criterion.Values[i];
                var currentScore = Model.CriterionValueScores.FirstOrDefault(v => v.Id == value.Id)?.Score ?? value.Score;
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">
                        <label class="govuk-label govuk-!-margin-bottom-0" for="criterion-value-score-@i">@value.Value</label>
                    </td>
                    <td class="govuk-table__cell">
                        <input type="text" id="criterion-value-score-@i" value="@currentScore" maxlength="3" class="govuk-input govuk-input--width-3" inputmode="numeric" spellcheck="false"
                               data-value-id="@value.Id" data-value-name="@value.Value" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="govuk-button-group app-button-group--right">
    <button type="button" class="govuk-button" data-module="govuk-button" data-criterion-ok>OK</button>
    <button type="button" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-criterion-cancel>Cancel</button>
</div>
</div>
