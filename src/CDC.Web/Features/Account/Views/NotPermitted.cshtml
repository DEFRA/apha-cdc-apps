@{
    ViewData["Title"] = "You cannot sign in with this account";
    ViewData["HideAccountBar"] = true;
    ViewData["HideFooterNavigation"] = true;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">You cannot sign in with this account</h1>
        <p class="govuk-body">Your account is not authorised to view this page.</p>
        <a asp-controller="Account" asp-action="Logout" class="govuk-button govuk-button--secondary">
            Sign out
        </a>
    </div>
</div>
