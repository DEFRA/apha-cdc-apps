@{
    ViewData["Title"] = "You cannot sign in with this account";
    ViewData["HideAccountBar"] = true;
    ViewData["HideFooterNavigation"] = true;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">You cannot sign in with this account</h1>
        <p class="govuk-body">The account is not authorised to access the D2R2 service. If you are having any difficulties, please contact <a class="govuk-link" href="mailto:D2R2@defra.gov.uk">D2R2@defra.gov.uk</a>.</p>
        <a asp-controller="Account" asp-action="Logout" class="govuk-button govuk-button--secondary">
            Sign out
        </a>
    </div>
</div>
