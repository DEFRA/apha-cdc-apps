@{
    ViewData["Title"] = "D2R2";
    var fullName = User.FindFirst(ExternalUserClaimTypes.FullName)?.Value;
    var firstName = string.IsNullOrEmpty(fullName) ? null : fullName.Split(' ')[0];
}

<span class="govuk-caption-l">D2R2 Home</span>
<h1 class="govuk-heading-l">@(string.IsNullOrEmpty(firstName) ? "Welcome back" : $"Welcome back, {firstName}")</h1>
<p class="govuk-body">D2R2 is a comprehensive, peer-reviewed animal disease database and risk ranking tool, focused on the UK situation. Its standardised approach facilitates a transparent mechanism for making policy decisions.</p>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h2 class="govuk-heading-m">Popular on D2R2</h2>
        <ul class="govuk-list">
            <li class="govuk-!-margin-bottom-4">
                <a class="govuk-link govuk-!-font-weight-bold" asp-page="/SurveillanceProfiles/Search">Search disease profiles</a>
                <p class="govuk-body govuk-!-margin-bottom-0">Find information about diseases and the species they affect.</p>
            </li>
            <li class="govuk-!-margin-bottom-4">
                <a class="govuk-link govuk-!-font-weight-bold" asp-page="/Reports/DiseaseRanking">Disease ranking report</a>
                <p class="govuk-body govuk-!-margin-bottom-0">View the disease ranking report.</p>
            </li>
            <li class="govuk-!-margin-bottom-4">
                <a class="govuk-link govuk-!-font-weight-bold" asp-page="/Reports/General">General reports</a>
                <p class="govuk-body govuk-!-margin-bottom-0">View a list of published reports.</p>
            </li>
            <li class="govuk-!-margin-bottom-4">
                <a class="govuk-link govuk-!-font-weight-bold" asp-page="/ViewSpeciesData">View species data</a>
                <p class="govuk-body govuk-!-margin-bottom-0">Find information about specific species.</p>
            </li>
        </ul>
    </div>
    <div class="govuk-grid-column-one-third">
        <img class="app-home__side-logo govuk-!-margin-bottom-4" src="~/assets/images/D2R2LogoSmall.png" alt="D2R2 - Disease Briefing, Decision Support, Risk Assessment, Ranking" />
        <h2 class="govuk-heading-m">Quick links</h2>
        <ul class="govuk-list">
            <li><a class="govuk-link" asp-page="/HelpSupport/StaticReports" asp-route-UserManual="1">Help using D2R2</a></li>
            <li><a class="govuk-link" asp-page="/DiseaseProfiles/CompareVersions">Compare profile versions</a></li>
            <li><a class="govuk-link" href="#">Create disease ranking filter</a></li>
        </ul>
    </div>
</div>

