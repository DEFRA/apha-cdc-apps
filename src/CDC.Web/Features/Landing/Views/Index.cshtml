@{
    ViewData["Title"] = "Sign in to D2R2";
}

<span class="govuk-caption-l">D2R2</span>
<h1 class="govuk-heading-l">Disease Briefing, Decisions Support, Risk Assessment &amp; Ranking</h1>

<h2 class="govuk-heading-m">Please select how you would like to sign in</h2>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-one-half">
        <h3 class="govuk-heading-s">Internal User</h3>
        <p class="govuk-body">APHA staff signing in from the Defra corporate network.</p>
        <a asp-action="Internal" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
            Continue as Internal User
        </a>
    </div>
    <div class="govuk-grid-column-one-half">
        <h3 class="govuk-heading-s">External User</h3>
        <p class="govuk-body">External contributors and reviewers.</p>
        <a asp-action="External" role="button" draggable="false" class="govuk-button govuk-button--secondary" data-module="govuk-button">
            Continue as External User
        </a>
    </div>
</div>

