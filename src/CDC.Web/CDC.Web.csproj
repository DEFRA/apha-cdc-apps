<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cdc-web-8f3a2c6e-9d41-4b7a-9c2f-5e6a1d0b7c44</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDC.Common\CDC.Common.csproj" />
    <ProjectReference Include="..\CDC.Auth.Cidm\CDC.Auth.Cidm.csproj" />
    <ProjectReference Include="..\CDC.Auth.Entra\CDC.Auth.Entra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CDC.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Pdf\Assets\aphalogo.png" LogicalName="CDC.Web.Pdf.aphalogo.png" />
    <EmbeddedResource Include="Infrastructure\Pdf\Assets\D2R2LogoSmall.png" LogicalName="CDC.Web.Pdf.D2R2LogoSmall.png" />
    <!-- The spell check's English dictionary (SCOWL en_US, in Hunspell format), read by HunspellDictionary. -->
    <EmbeddedResource Include="Infrastructure\SpellCheck\Dictionaries\en_US.aff" LogicalName="CDC.Web.SpellCheck.en_US.aff" />
    <EmbeddedResource Include="Infrastructure\SpellCheck\Dictionaries\en_US.dic" LogicalName="CDC.Web.SpellCheck.en_US.dic" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dictionary's licence requires its copyright notice to travel with every copy, so it is published beside the app. -->
    <Content Include="Infrastructure\SpellCheck\Dictionaries\en_US.license.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
