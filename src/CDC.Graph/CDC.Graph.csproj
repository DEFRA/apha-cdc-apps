<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plain class library, not Sdk.Web: needed for IOptions, IHttpClientFactory and QueryHelpers. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CDC.Graph.Tests" />
  </ItemGroup>

</Project>
